export image_name := env("IMAGE_NAME", "athanor-system")
export default_tag := env("DEFAULT_TAG", "latest")
export bib_image := env("BIB_IMAGE", "quay.io/centos-bootc/bootc-image-builder:latest")

[private]
default:
    @just --list

# Check Just Syntax
[group('Just')]
check:
    just --unstable --fmt --check -f Justfile

# Fix Just Syntax
[group('Just')]
fix:
    just --unstable --fmt -f Justfile

# Clean Repo Build Artifacts
[group('Utility')]
clean:
    rm -rf *_build* previous.manifest.json changelog.md output.env output/ system-sbom.spdx.json

# Build OS Container Image
[group('Build')]
build target_image=image_name tag=default_tag:
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/build_container.sh "{{ target_image }}" "{{ tag }}"

_build-bib target_image tag type:
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/build_bib.sh "{{ target_image }}" "{{ tag }}" "{{ type }}"

# Build Virtual Machine Disk Image (qcow2)
[group('Build VM Image')]
build-vm type="qcow2" target_image=("localhost/" + image_name) tag=default_tag:
    just _build-bib "{{ target_image }}" "{{ tag }}" "{{ type }}"

# Build Anaconda Installer ISO Image
[group('Build VM Image')]
build-iso target_image=("localhost/" + image_name) tag=default_tag:
    just _build-bib "{{ target_image }}" "{{ tag }}" "iso"

# Build Bare-Metal Ring-0 Unikernel Binary (RustyHermit)
[group('Build')]
build-unikernel component="athanor-unikernel-daemon" mode="release":
    ./scripts/build_unikernel.sh "{{ component }}" "{{ mode }}"

# Security Scan of System Image using Trivy
[group('QA & Security')]
security-scan target_image=("localhost/" + image_name) tag=default_tag:
    trivy image "{{ target_image }}:{{ tag }}" --severity CRITICAL,HIGH

# Strictly enforces 0700/0400 permissions on Secure Boot signing keys (KEK, PK, db, UKI keys)
[group('QA & Security')]
secureboot-key-audit:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Auditing Secure Boot & UKI key permissions..."
    if [ -d "/etc/pki/secureboot/private" ]; then
        chmod 0700 /etc/pki/secureboot/private
    fi
    for k in /etc/pki/secureboot/private/*.key /etc/pki/uki/*.key /run/secrets/*.key; do
        if [ -f "$k" ]; then
            chmod 0400 "$k"
            echo "  ✓ Secured $k (chmod 0400)"
        fi
    done
    if [ -f "/etc/pki/uki/uki-signing.key" ]; then
        echo "⚠️ WARNING: Private UKI signing key found in generic path /etc/pki/uki/uki-signing.key!"
        echo "  Migrating key to isolated enclave /etc/pki/secureboot/private/..."
        mkdir -p /etc/pki/secureboot/private
        chmod 0700 /etc/pki/secureboot/private
        mv -f /etc/pki/uki/uki-signing.key /etc/pki/secureboot/private/uki-signing.key
        chmod 0400 /etc/pki/secureboot/private/uki-signing.key
    fi
    echo "✅ Secure Boot key permission audit complete."

# Generate SPDX SBOM using Syft
[group('QA & Security')]
generate-sbom target_image=("localhost/" + image_name) tag=default_tag output_file="system-sbom.spdx.json":
    syft packages "{{ target_image }}:{{ tag }}" -o spdx-json="{{ output_file }}"

# Runs shellcheck on all Bash scripts
[group('Utility')]
lint:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v shellcheck >/dev/null 2>&1; then find . -iname "*.sh" -type f -exec shellcheck "{}" +; else echo "shellcheck not found, skipping"; fi

# Runs shfmt on all Bash scripts
[group('Utility')]
format:
    #!/usr/bin/env bash
    set -euo pipefail
    find . -iname "*.sh" -type f -exec shfmt --write "{}" +
