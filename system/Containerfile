# The Athanor system images (docs/architecture/doc_system_image.md). One file, three images
# selected by the GPU build argument: none (athanor-system), nvidia (athanor-system-nvidia)
# and nvidia-legacy (athanor-system-nvidia-legacy). Everything up to the `system` stage is
# shared; the GPU stages add the signed NVIDIA modules of the Azoth kernel with the locked
# vendor packages; the final stage gates, generates the initramfs and lints. No key reaches the
# build: the vmlinuz is the one signed for Secure Boot in the kernel cycle (azoth-boot, D43).
# system/build-image.sh passes AZOTH_NVR, the registries, the signed vmlinuz digest and the module
# digests from the file system/kernel-artifacts.sh
# wrote (docs/architecture/doc_build_ordering.md, O4, O9). A stage the target does not use is
# never pulled, so the default image builds without module digests.
# The `system` stage is built once, on its own (--target system), and the GPU stages start FROM
# its image ID, SYSTEM_IMAGE: the three images carry the same system layers, built once per run
# (docs/architecture/doc_update_delivery.md, UD40). A variant build never runs the stage itself.
ARG AZOTH_NVR
ARG GPU=none
ARG KERNEL_REGISTRY
ARG FORGE_REGISTRY
ARG NVIDIA_OPEN_DIGEST
ARG NVIDIA_LEGACY_DIGEST
ARG BOOT_DIGEST
ARG SYSTEM_IMAGE
ARG TIER0_DIGEST
ARG TIER1_DIGEST
ARG TIER2_DIGEST
ARG TIER3_DIGEST
# Packages Athanor builds and serves from tier 2 that Fedora also ships. Every dnf
# transaction after tier 2 hides Fedora's builds with these options, so no later
# install, --allowerasing or newer Fedora release can replace Athanor's: Fedora's
# cosmic-comp 1.9.0 did, through the tier 3 transaction, on 2026-10-08. The installed
# packages still satisfy what other packages require; the release assertions in the
# system stage stay as the check.
ARG ATHANOR_OWNED_EXCLUDES="--exclude=cosmic-comp --exclude=greenboot --exclude=greenboot-default-health-checks"

# The vmlinuz of the pinned kernel signed with the Secure Boot key, /vmlinuz and /kver
# (forge/specs/azoth/nvidia-publish.sh); system/kernel-artifacts.sh verified its signature and
# its attestation of the kernel digest and the certificate.
FROM ${KERNEL_REGISTRY}/azoth-boot@${BOOT_DIGEST} AS signed-kernel

FROM ${KERNEL_REGISTRY}/azoth-nvidia@${NVIDIA_OPEN_DIGEST} AS nvidia-modules-open
FROM ${KERNEL_REGISTRY}/azoth-nvidia@${NVIDIA_LEGACY_DIGEST} AS nvidia-modules-legacy

# The forge tier repositories, bound by the four tier steps of the system stage, by digest:
# system/build-image.sh passes FORGE_REGISTRY and the four digests from tier-digests.json,
# which the run that published the tiers wrote (forge/scripts/publish_tiers.sh) or
# system/tier-digests.sh resolved once for a build outside it (doc_update_delivery.md, UD28).
# The ARGs stay in these FROM lines: inside a RUN --mount=...,from= value an ARG made
# buildah 5.8.4 SIGSEGV at commit (exit 134), taking down all three images.
FROM ${FORGE_REGISTRY}/athanor-forge-tier0-repo@${TIER0_DIGEST} AS tier0-repo
FROM ${FORGE_REGISTRY}/athanor-forge-tier1-repo@${TIER1_DIGEST} AS tier1-repo
FROM ${FORGE_REGISTRY}/athanor-forge-tier2-repo@${TIER2_DIGEST} AS tier2-repo
FROM ${FORGE_REGISTRY}/athanor-forge-tier3-repo@${TIER3_DIGEST} AS tier3-repo

# The vendor RPMs of both NVIDIA branches, verified by hash and GPG, with the shim and the
# configuration package, and NVIDIA's container toolkit (system/nvidia/build-rpms.sh). A throwaway stage: rpm-build never
# reaches an image. KERNEL_REGISTRY locates the mirror of the locked RPMs (lock.py).
FROM registry.fedoraproject.org/fedora:43@sha256:005ce311c13eaa639de9d9c52e470f10652c7371561697fb8c1c6e852e23c481 AS nvidia-rpms
ARG KERNEL_REGISTRY
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY forge/specs/azoth/pins.env /src/forge/specs/azoth/pins.env
COPY system/nvidia/ /src/system/nvidia/
RUN dnf5 install -y --setopt=install_weak_deps=False rpm-build python3 && \
    bash /src/system/nvidia/build-rpms.sh /out

# Fedora's atomic desktop base (S1): the bootc base of Silverblue and Kinoite, pinned by
# digest and moved by the bump bot.
FROM quay.io/fedora-ostree-desktops/base-atomic:43@sha256:dd433238d918379d234eeacc2bfa2dfd854c8af821e1e5723818d63b5120f464 AS system
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FEDORA_VERSION=43
ENV FEDORA_VERSION=$FEDORA_VERSION
ARG TETRAGON_VERSION=v1.3.0
ARG ATHANOR_OWNED_EXCLUDES


# TIER 0: BEDROCK HARDWARE & KERNEL FOUNDATION
# The tier repositories mount under /tmp: in an ostree image /mnt is a symlink to var/mnt,
# which does not exist at build time, so podman cannot create a mount target below it.
RUN --mount=type=bind,from=tier0-repo,source=/,target=/tmp/tier0-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    base_kernel=$(rpm -qa kernel kernel-core 'kernel-modules*' 'kernel-uki-virt*') && \
    if [ -n "$base_kernel" ]; then \
        echo "Tier 0: Removing the base image kernel: bootc supports one kernel per image and Azoth is installed below..." && \
        dnf5 remove -y --no-autoremove $base_kernel; \
    fi && \
    BASE_CONFIG=$(find /tmp/tier0-repo -name "athanor-base-config*.rpm" | head -n 1) && \
    if [ -n "$BASE_CONFIG" ]; then \
        echo "Tier 0: Installing core Athanor Forge base configuration..." && \
        if rpm -q fedora-logos >/dev/null; then rpm -e --nodeps fedora-logos; fi && \
        rpm -Uvh --replacefiles --replacepkgs --nodeps "$BASE_CONFIG"; \
    fi && \
    RPM_LIST=$(find /tmp/tier0-repo -name "*.rpm" 2>/dev/null | awk '!/systemd-standalone-|.*-free-.*\.rpm|glibc32|kernel-debug|rpm-.*\.rpm|fedora-release-|selinux-policy|athanor-base-config|-doc-|debuginfo|debugsource/ && (!/-devel-/ || /kernel-devel/)') && \
    if [ -n "$RPM_LIST" ]; then \
        echo "Tier 0: Installing the hardware foundation and the Azoth kernel..." && \
        dnf5 install -y --allowerasing --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
    fi && \
    rm -rf /usr/lib/firmware/{mellanox,qlogic,netronome,liquidio,cxgb4,bnx2x,cavium,dpaa2}

# fedora-workstation-repositories ships third-party repository definitions (RPM Fusion's
# NVIDIA driver, Google Chrome, Steam, a PyCharm copr): the default image carries no NVIDIA
# driver repository and packages come only from the configured origins (doc_system_image.md,
# S1, S3).
RUN if rpm -q fedora-workstation-repositories >/dev/null; then \
        dnf5 remove -y --no-autoremove fedora-workstation-repositories; \
    fi

# base-atomic ships the noopenh264 stub; the H.264 codec is Cisco's openh264 from Fedora's own
# fedora-cisco-openh264 repository, which replaces the stub (doc_system_image.md, S1).
RUN dnf5 install -y --allowerasing --enablerepo=fedora-cisco-openh264 openh264 && \
    rpm -q openh264 && \
    ! rpm -q noopenh264

# The Azoth kernel of the pins is the one tier 0 installed. Its vmlinuz is replaced by the
# same kernel signed for Secure Boot, which shim accepts through MokList; `rpm -V kernel-core`
# reports the file as modified (doc_system_image.md). azoth-boot names in /kver the kernel it
# signed: a BOOT_DIGEST of another kernel fails here, not at boot. The mode is the RPM's.
ARG AZOTH_NVR
RUN test -f "/usr/lib/modules/${AZOTH_NVR}.x86_64/vmlinuz"
RUN --mount=type=bind,from=signed-kernel,source=/kver,target=/tmp/azoth-boot-kver \
    signed=$(cat /tmp/azoth-boot-kver) && \
    if [ "$signed" != "${AZOTH_NVR}.x86_64" ]; then echo "azoth-boot signed the vmlinuz of $signed, not of ${AZOTH_NVR}.x86_64" >&2; exit 1; fi
COPY --chmod=0755 --from=signed-kernel /vmlinuz /usr/lib/modules/${AZOTH_NVR}.x86_64/vmlinuz

# Tier 0: Install Cilium Tetragon eBPF Runtime Security is now delegated to athanor-tetragon RPM

# TIER 1: CORE USERSERVICE, DBUS & POLICYKIT
RUN --mount=type=bind,from=tier1-repo,source=/,target=/tmp/tier1-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    echo "Tier 1: Installing Keylime (installed, disabled), TPM and LUKS tools..." && \
    dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs keylime-tenant keylime-agent systemd-ukify openssl tpm2-tools cryptsetup dracut && \
    if find /tmp/tier1-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 1: Installing Core User Services, DBus & Policies..." && \
        RPM_LIST=$(find /tmp/tier1-repo -name "*.rpm" ! -name "*-devel-*" ! -name "*-doc-*" ! -name "*debuginfo*" ! -name "*debugsource*" ! -name "*buildah*" ! -name "*osbuild*") && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# TIER 2: DESIGN SYSTEM & STATIC ASSETS
RUN --mount=type=bind,from=tier2-repo,source=/,target=/tmp/tier2-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /tmp/tier2-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 2: Installing Design System & Static Assets..." && \
        RPM_LIST=$(find /tmp/tier2-repo -name "*.rpm" ! -name "*-devel-*" ! -name "*-doc-*" ! -name "*debuginfo*" ! -name "*debugsource*" ! -name "*buildah*" ! -name "*osbuild*") && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# TIER 3: AGILE RUST SHELL & APPS
RUN --mount=type=bind,from=tier3-repo,source=/,target=/tmp/tier3-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /tmp/tier3-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 3: Installing Agile Rust Shell & Apps..." && \
        RPM_LIST=$(find /tmp/tier3-repo -name "*.rpm" ! -name "*-devel-*" ! -name "*-doc-*" ! -name "*debuginfo*" ! -name "*debugsource*" ! -name "*buildah*" ! -name "*osbuild*") && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y $ATHANOR_OWNED_EXCLUDES --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

COPY forge/config/packages.json /usr/share/athanor/packages.json

# UPSTREAM PACKAGES: the desktop (COSMIC), media, and CLI packages the manifest lists
# under upstream_*. Today these are the official Fedora and RPM Fusion binaries,
# installed here from the repositories the base image configures -- the same origin as
# the rest the base already carries (Vendor: Fedora Project). Zero-trust
# debt (2026-09-11 decision): they are to be rebuilt from source in the Athanor builder
# and served from the tier repositories, as the custom packages are; until then Fedora's
# GPG signatures are the provenance. The list is the single source of truth in
# packages.json, so a package added there reaches the image. --allowerasing lets the
# RPM Fusion ffmpeg replace the base image's ffmpeg-free; ATHANOR_OWNED_EXCLUDES keeps it
# from replacing Athanor's tier 2 builds.
RUN --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    dnf5 install -y $ATHANOR_OWNED_EXCLUDES --setopt=install_weak_deps=False --setopt=tsflags=nodocs jq && \
    UPSTREAM=$(jq -r '(.upstream_core + .upstream_desktop + .upstream_media + .upstream_cli)[]' /usr/share/athanor/packages.json) && \
    echo "Installing upstream packages: $UPSTREAM" && \
    dnf5 install -y --allowerasing $ATHANOR_OWNED_EXCLUDES --setopt=install_weak_deps=False --setopt=tsflags=nodocs $UPSTREAM

# FLATPAK MANIFEST: the applications are provisioned on the installed system, not at
# build time. Extra-data apps such as Chrome run an apply_extra script under
# bubblewrap, which a build container cannot host, and bootc carries /var into the
# first deployment only.
RUN dnf5 install -y $ATHANOR_OWNED_EXCLUDES --setopt=install_weak_deps=False --setopt=tsflags=nodocs flatpak

COPY system/scripts/ /scripts/


# Custom SELinux policy modules. athanor-selinux installs its CIL modules under
# /usr/share/selinux/packages, but a .cil placed there is not active until it is loaded
# into the policy store with `semodule -i`; there is no OSTree-safe %post to do it (the
# scriptlet was purged for immutability), so the modules were dead files. Load them at
# build time here, which writes them into /etc/selinux/targeted and bakes them into the
# image. This activates athanor_nix_daemon (the Nix store, socket and daemon types and
# their file contexts) and athanor_scx, which had never been loaded.
RUN if ls /usr/share/selinux/packages/*.cil >/dev/null 2>&1; then \
        echo "Loading custom SELinux policy modules..." && \
        semodule -i /usr/share/selinux/packages/*.cil; \
    fi

# Signature policy of the system images (docs/architecture/doc_update_trust.md, UT3). The
# container tools read /etc/containers only, so the policy is rendered under /usr, for the
# registry this image is published to and the public keys committed under system/keys, and
# /etc/containers/policy.json and registries.d/athanor.yaml become links to it. No default:
# build-image.sh always passes the registry, and the renderer refuses an empty one.
ARG IMAGE_REGISTRY
COPY system/keys/ /usr/share/athanor/keys/
RUN /usr/libexec/athanor-update/render-policy --registry "${IMAGE_REGISTRY}" --keys-dir /usr/share/athanor/keys \
        --out /usr/share/athanor/containers --link-etc /etc && \
    test "$(readlink /etc/containers/policy.json)" = /usr/share/athanor/containers/policy.json && \
    test "$(readlink /etc/containers/registries.d/athanor.yaml)" = /usr/share/athanor/containers/registries.d/athanor.yaml && \
    test "$(grep -c sigstoreSigned /etc/containers/policy.json)" -eq 3

# Declarative Systemd presets & sysusers
RUN systemctl enable tetragon.service systemd-sysext.service && systemd-sysusers && systemctl preset-all && systemctl --global preset-all

# Keylime is installed and stays disabled: no verifier exists for its agent to report to
# (scripts/verify.py shipped forbids enabling it in the sources; this is the image check).
RUN ! systemctl is-enabled --quiet keylime_agent.service

# No account authenticates with an empty password (#152). The base image's "local" authselect
# profile ships nullok on pam_unix; the feature removes it from every generated stack.
RUN authselect enable-feature without-nullok && \
    test -s /etc/pam.d/system-auth && test -s /etc/pam.d/password-auth && \
    ! grep -n nullok /etc/pam.d/system-auth /etc/pam.d/password-auth

# Account lockout (ADR-0090): five wrong passwords within fifteen minutes lock the account for
# ten minutes, at login, sudo and every other service that includes system-auth. root is not
# locked out (even_deny_root and admin_group stay unset). The recovery console is an
# administrator's login, not root's: it stays reachable because the tally lives in /run/faillock
# (tmpfs), so a boot into the recovery entry starts with no failures. The accepted trade-off is
# that anyone who can reach a password prompt can lock the administrator out for ten minutes,
# repeatedly. pam 1.7.1 reads only /etc/security/faillock.conf (no drop-in directory), hence the
# appended block. The build fails if either stack lacks the module or a setting is not last-wins.
RUN authselect enable-feature with-faillock && \
    printf '%s\n' '' '# Athanor (system/Containerfile, ADR-0090).' \
        'deny = 5' 'fail_interval = 900' 'unlock_time = 600' >> /etc/security/faillock.conf && \
    for stack in system-auth password-auth; do \
        grep -q '^auth .*pam_faillock.so preauth' "/etc/pam.d/$stack" \
            && grep -q '^auth .*pam_faillock.so authfail' "/etc/pam.d/$stack" \
            || { echo "pam_faillock is missing from $stack" >&2; exit 1; }; \
    done && \
    for setting in deny=5 fail_interval=900 unlock_time=600; do \
        test "$(grep -E "^[[:space:]]*${setting%%=*}[[:space:]]*=" /etc/security/faillock.conf \
            | tail -n 1 | tr -d '[:space:]')" = "$setting" \
            || { echo "faillock.conf does not end with $setting" >&2; exit 1; }; \
    done && \
    ! grep -En '^[[:space:]]*(even_deny_root|admin_group)' /etc/security/faillock.conf

# Short passwords. pam_pwquality asks a new password for twelve characters; systemd-homed reads
# the same configuration for homectl passwd. Existing passwords are not touched.
RUN install -d -m 0755 /etc/security/pwquality.conf.d && \
    printf '%s\n' '# Athanor (system/Containerfile).' 'minlen = 12' \
        > /etc/security/pwquality.conf.d/50-athanor.conf

# The computer never announces itself over mDNS (ADR-0089, decision 2): avahi browses, so printers
# and services are still found, and publishes nothing, not even the host name. /etc/avahi is
# merged on update, so a machine that edited the file keeps its own.
RUN if rpm -q --quiet avahi; then \
        sed -i 's/^#\?disable-publishing=.*/disable-publishing=yes/' /etc/avahi/avahi-daemon.conf && \
        grep -qx 'disable-publishing=yes' /etc/avahi/avahi-daemon.conf; \
    fi

# Stage 2 switch (doc_shell.md, section 8, item 2): the COSMIC shell is gone, our shell is
# enabled for every user, and each bus name it owns has exactly one activation file.
RUN for pkg in cosmic-panel cosmic-applets cosmic-notifications athanor-layout-translator; do \
        if rpm -q --quiet "$pkg"; then echo "the image still carries $pkg" >&2; exit 1; fi; \
    done && \
    for unit in athanor-bar athanor-dock athanor-shelld; do \
        test -L "/etc/systemd/user/athanor-session.target.wants/$unit.service" \
            || { echo "$unit.service is not enabled for every user" >&2; exit 1; }; \
    done && \
    case $(rpm -q --qf '%{RELEASE}' cosmic-comp) in *.athanor*) ;; \
        *) echo "cosmic-comp is not Athanor's build: $(rpm -q cosmic-comp)" >&2; exit 1;; esac && \
    for name in org.freedesktop.Notifications org.kde.StatusNotifierWatcher; do \
        owners=$(grep -lx "Name=$name" /usr/share/dbus-1/services/*.service); \
        test "$owners" = "/usr/share/dbus-1/services/$name.service" \
            || { echo "$name is activated by: $owners" >&2; exit 1; }; \
    done

# Health checks (doc_recovery.md, R5): Athanor's greenboot build, which can mark a failed
# update without rebooting, enabled by athanor-recovery's preset and configured not to reboot.
# The configuration reaches /etc through tmpfiles.d at boot, so the build checks its source.
# The tmpfiles grep reads the whole stream: with -q it would stop at the match and, under
# pipefail, systemd-tmpfiles killed by SIGPIPE would fail the step (exit 141).
RUN for pkg in greenboot greenboot-default-health-checks; do \
        case $(rpm -q --qf '%{RELEASE}' "$pkg") in *.athanor*) ;; \
            *) echo "$pkg is not Athanor's build: $(rpm -q "$pkg")" >&2; exit 1;; esac; \
    done && \
    for unit in greenboot-healthcheck greenboot-set-rollback-trigger; do \
        test "$(systemctl is-enabled "$unit.service")" = enabled \
            || { echo "$unit.service is not enabled" >&2; exit 1; }; \
    done && \
    grep -qx 'GREENBOOT_AUTO_REBOOT=false' /usr/share/athanor-system-config/greenboot.conf && \
    systemd-tmpfiles --cat-config \
        | grep -xF 'L+ /etc/greenboot/greenboot.conf - - - - /usr/share/athanor-system-config/greenboot.conf' > /dev/null

# GPU stages (S2-S5): the signed modules of the kernel NVR with the locked vendor packages of
# the same version, the shim and athanor-nvidia-config. libva-nvidia-driver (VA-API on NVDEC)
# only makes sense with the NVIDIA driver, and so does the locked container toolkit (S4), which
# gives containers the GPU through CDI. SYSTEM_IMAGE is the image ID of the `system` stage,
# built beforehand by system/build-image.sh.
FROM ${SYSTEM_IMAGE} AS gpu-none

# The modules must land in the directory of the pinned kernel: hardening deletes every other
# modules directory, so a mismatch fails here rather than silently later.
FROM ${SYSTEM_IMAGE} AS gpu-nvidia
ARG AZOTH_NVR
ARG ATHANOR_OWNED_EXCLUDES
COPY --from=nvidia-modules-open /lib/modules/ /usr/lib/modules/
RUN test -f "/usr/lib/modules/${AZOTH_NVR}.x86_64/extra/nvidia/nvidia.ko"
RUN --mount=type=bind,from=nvidia-rpms,source=/out/open,target=/tmp/nvidia-rpms \
    --mount=type=bind,from=nvidia-rpms,source=/out/container-toolkit,target=/tmp/container-toolkit \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    dnf5 install -y $ATHANOR_OWNED_EXCLUDES --setopt=install_weak_deps=False --setopt=tsflags=nodocs /tmp/nvidia-rpms/*.rpm \
        /tmp/container-toolkit/*.rpm libva-nvidia-driver && \
    systemctl preset-all

FROM ${SYSTEM_IMAGE} AS gpu-nvidia-legacy
ARG AZOTH_NVR
ARG ATHANOR_OWNED_EXCLUDES
COPY --from=nvidia-modules-legacy /lib/modules/ /usr/lib/modules/
RUN test -f "/usr/lib/modules/${AZOTH_NVR}.x86_64/extra/nvidia/nvidia.ko"
RUN --mount=type=bind,from=nvidia-rpms,source=/out/legacy,target=/tmp/nvidia-rpms \
    --mount=type=bind,from=nvidia-rpms,source=/out/container-toolkit,target=/tmp/container-toolkit \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    dnf5 install -y $ATHANOR_OWNED_EXCLUDES --setopt=install_weak_deps=False --setopt=tsflags=nodocs /tmp/nvidia-rpms/*.rpm \
        /tmp/container-toolkit/*.rpm libva-nvidia-driver && \
    systemctl preset-all

FROM gpu-${GPU} AS final
ARG GPU
ARG AZOTH_NVR
COPY forge/specs/azoth/pins.env /scripts/pins.env
COPY system/nvidia/gate.sh /scripts/nvidia-gate.sh
RUN bash /scripts/nvidia-gate.sh "${GPU}" /scripts/pins.env /

# The one preset a preset cannot apply. NetworkManager.service carries
# Also=NetworkManager-wait-online.service, so every `systemctl preset-all` that enables
# NetworkManager re-creates the wait-online link afterwards, whatever
# 80-athanor-base.preset says about it; `Also=` is evaluated when the other unit is
# enabled and no preset line outranks it. This re-applies our own preset policy to that
# single unit, after the last preset-all of the build (the GPU stages run one of their
# own), so the image ships what the preset file declares. The intent stays in the preset
# file; this is only the last word.
RUN systemctl preset NetworkManager-wait-online.service

# Module index and initramfs, once every module is in place
RUN bash /scripts/initramfs.sh "${AZOTH_NVR}.x86_64"

# Hardening & OSTree cleanup. glibc-all-langpacks stays: glibc requires a langpack
# provider and it is the one the base image ships. The runtime directories are
# emptied entry by entry, skipping the build-time mounts podman places under /run
# (secrets, resolv.conf); every command is part of one && chain, so the step fails
# as soon as one of them does. grep reads the whole mount list: with -q, findmnt killed
# by SIGPIPE would make the test true under pipefail and remove a mount point.
RUN dnf5 remove -y --no-autoremove \
        gcc make llvm-static rust-std-static mesa-dxil-devel \
        edk2-aarch64 qemu-user qemu-user-static distribution-gpg-keys-copr \
        nodejs-docs python3-botocore kernel-debug kernel-debug-core kernel-debug-modules kernel-debug-modules-core kernel-debug-modules-extra && \
    for d in /usr/lib/modules/*; do if [ -d "$d" ] && [ ! -e "$d/vmlinuz" ] && [ ! -L "$d/vmlinuz" ]; then rm -rf "$d"; fi; done && \
    rm -f /etc/machine-id && touch /etc/machine-id && \
    rm -rf /scripts && \
    dnf5 clean all && \
    rm -rf /var/lib/dnf5/* /var/tmp/* /var/log/* && \
    for p in /tmp/* /run/* /etc/NetworkManager/system-connections/*; do \
        if [ -e "$p" ] && ! findmnt -rno TARGET | grep "^$p" > /dev/null; then rm -rf "$p" || exit 1; fi; \
    done

# Image Validation & Linting
RUN ls -la /usr/lib/modules/ && bootc container lint
