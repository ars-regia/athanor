{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-candidate.json (docs/architecture/doc_pipeline.md, PL55 and PL58)",
  "description": "request is checked against release-request.schema.json on its own: the subset has no $ref.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "build_time", "order", "classes", "superseded"],
  "properties": {
    "schema_version": {"const": 2},
    "request": {"type": "object"},
    "build_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"},
    "order": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "candidate_digest", "latest_digest", "latest_created", "verdict"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$"},
          "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "latest_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "latest_created": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"},
          "verdict": {"enum": ["absent", "equal", "newer"]}
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "baseline_digest", "candidate_digest", "class", "advisories", "class_reason", "updateinfo_timestamp"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$"},
          "baseline_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "class": {"enum": ["security", "feature"]},
          "advisories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}},
          "class_reason": {"type": "string", "pattern": "^(no-baseline|(unlabelled-baseline,?)?(base-change:[0-9]+->[0-9]+)?)$"},
          "updateinfo_timestamp": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "superseded": {"type": "array", "items": {"type": "integer", "minimum": 1}}
  }
}
