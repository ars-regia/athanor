# Pins and sizing of the self-hosted runner VM (scripts/runner/README.md). Sourced by
# build-image.sh, vm.sh and install.sh; each value can be overridden from the environment.
REPOSITORY=${REPOSITORY:-hr-mes/athanor}
RUNNER_LABELS=${RUNNER_LABELS:-self-hosted,Linux,X64}

# actions/runner release and the SHA-256 of actions-runner-linux-x64-<version>.tar.gz,
# as published in the release notes.
RUNNER_VERSION=${RUNNER_VERSION:-2.337.0}
RUNNER_SHA256=${RUNNER_SHA256:-70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613}

# Fedora Cloud Base, verified against the CHECKSUM file signed with the Fedora 43 key.
FEDORA_IMAGE=${FEDORA_IMAGE:-Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2}
FEDORA_IMAGE_URL=${FEDORA_IMAGE_URL:-https://dl.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images}
FEDORA_IMAGE_SHA256=${FEDORA_IMAGE_SHA256:-846574c8a97cd2d8dc1f231062d73107cc85cbbbda56335e264a46e3a6c8ab2f}

# The VM: 12 of the 16 host cores and 16 of 31 GB keep the desktop and the 8 GB
# development VM of scripts/devvm usable during a kernel build; the service allows
# 22 GB (MemoryMax=), so QEMU keeps headroom above the guest's own 16 GB (20 GB of guest
# once left QEMU no room and the cgroup hit its limit 250 thousand times in one build).
# The cache disk persists across jobs (podman storage, ~/.cache/azoth); the scratch disk
# is recreated empty before every job (the runner work directory).
VM_CPUS=${VM_CPUS:-12}
VM_MEMORY=${VM_MEMORY:-16G}
# The guest's memory is not reserved: a balloon regulator (balloon.py) shrinks the guest
# whenever the host has less than HOST_RESERVE available, never below BALLOON_FLOOR, and
# grows it back once the host has room. Without it an image build filled the guest with
# page cache and the host's OOM killer ended the job by killing QEMU (2026-09-28).
BALLOON_FLOOR=${BALLOON_FLOOR:-6G}
HOST_RESERVE=${HOST_RESERVE:-3G}
CACHE_DISK_SIZE=${CACHE_DISK_SIZE:-400G}
SCRATCH_DISK_SIZE=${SCRATCH_DISK_SIZE:-200G}
