# shellcheck shell=bash
# Defaults and shared helpers of the development VM (scripts/devvm/README.md). Sourced by
# every script here; each value can be overridden from the environment.

# Guest size. 4 vCPUs and 8 GB fit beside the 12 vCPU / 16 GB runner guest on a 16-core,
# 31 GB host and leave the desktop usable.
CPUS=${CPUS:-4}
MEMORY=${MEMORY:-8G}
DISK_GIB=${DISK_GIB:-40}
SSH_PORT=${SSH_PORT:-2222}
# gtk opens a window on the host session; egl-headless renders on the host GPU with no
# window and serves the screen over SPICE on 127.0.0.1:SPICE_PORT.
DISPLAY_BACKEND=${DISPLAY_BACKEND:-gtk}
SPICE_PORT=${SPICE_PORT:-5930}
# Heads on the guest GPU (virtio-gpu max_outputs), for multi-output work. A second head
# starts disconnected; the guest plugs it by forcing the connector's status
# (/sys/class/drm/card1-Virtual-2/status: on or off) and then sending a change uevent
# (udevadm trigger --action=change /sys/class/drm/card1): the forced status alone raises none.
GPU_OUTPUTS=${GPU_OUTPUTS:-1}
# Pins the guest NIC to the same PCI slot in create.sh's install-time QEMU command line and
# start.sh's boot-time one. Left to auto-assignment, the two command lines put the NIC at a
# different slot -- create.sh also attaches the kickstart floppy and the ISO's virtio-scsi
# controller, start.sh instead attaches virtio-rng, an XHCI controller and the GPU -- and
# systemd's predictable network naming turns that into a different interface name each
# time (enp0s3 during install, enp0s1 at every later boot). The devvm.ks network command
# pins its static configuration to whatever interface is up at install time, so it silently
# stopped applying to the installed system: every real boot fell back to NetworkManager's
# own DHCP autoconnect for the unconfigured device, and slirp does not reliably hand the
# same lease back on a reboot (10.0.2.15 becoming 10.0.2.16, the bug this pin removes for
# good by keeping the interface name itself constant).
NIC_PCI_ADDR=${NIC_PCI_ADDR:-bus=pcie.0,addr=0x1e}

# The published ISO: a run id, or `newest` for the highest run id in the registry.
REGISTRY=${REGISTRY:-ghcr.io/${GITHUB_REPOSITORY_OWNER:-hr-mes}}
ISO_IMAGE=${ISO_IMAGE:-$REGISTRY/athanor-iso}
ISO_TAG=${ISO_TAG:-newest}
# The published system image upgrade.sh switches the guest to.
SYSTEM_IMAGE=${SYSTEM_IMAGE:-$REGISTRY/athanor-system}

STATE=${STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/athanor-devvm}
# The transient user unit QEMU runs in (start.sh).
UNIT=${UNIT:-athanor-devvm}
GUEST_USER=${GUEST_USER:-$(id -un)}

die() { echo "error: $*" >&2; exit 1; }
need_qemu_img() {
  command -v qemu-img > /dev/null || die "qemu-img not found: install it (e.g. nix profile install nixpkgs#qemu-utils)"
}

# The private key ssh uses: the host user's own, or a dedicated one create.sh generated
# in the state directory when the user has none.
ssh_key() {
  if [[ -f $HOME/.ssh/id_ed25519.pub ]]; then echo "$HOME/.ssh/id_ed25519"; else echo "$STATE/id_ed25519"; fi
}

guest_ssh() { # guest_ssh [ssh args...]
  ssh -i "$(ssh_key)" -p "$SSH_PORT" -o StrictHostKeyChecking=accept-new \
    -o "UserKnownHostsFile=$STATE/known_hosts" -o ConnectTimeout=5 "$GUEST_USER@127.0.0.1" "$@"
}

# UEFI firmware, looked up the way forge/test/iso/run_iso_test.sh does: Debian and Ubuntu
# ship OVMF_CODE_4M.fd under /usr/share/OVMF, Fedora OVMF_CODE.fd under /usr/share/edk2/ovmf.
ovmf_code() {
  local dir suffix
  for dir in /usr/share/OVMF /usr/share/edk2/ovmf /usr/share/ovmf; do
    for suffix in _4M ''; do
      if [[ -f $dir/OVMF_CODE$suffix.fd && -f $dir/OVMF_VARS$suffix.fd ]]; then
        echo "$dir/OVMF_CODE$suffix.fd"
        return
      fi
    done
  done
  die "OVMF firmware not found (OVMF_CODE[_4M].fd in /usr/share/OVMF, /usr/share/edk2/ovmf, /usr/share/ovmf)"
}
