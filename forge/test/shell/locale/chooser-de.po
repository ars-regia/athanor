msgstr "Dock"

msgid "Visible"
msgstr "Sichtbar"

msgid "Auto-hide"
msgstr "Automatisch ausblenden"

msgid "None"
msgstr "Keines"

msgid "Set by your administrator."
msgstr "Von Ihrer Administration festgelegt."

msgid "The bar holds the running applications."
msgstr "Der Balken enthält die laufenden Anwendungen."

msgid "Replace the newer layout?"
msgstr "Die neuere Anordnung ersetzen?"

#, rust-format
msgid "Athanor keeps the current file as {file}."
msgstr "Athanor bewahrt die aktuelle Datei als {file} auf."

msgid "Cancel"
