From ee811dd792c9e836d5ecc0d5dc6098f91472ad42 Mon Sep 17 00:00:00 2001
From: Ermete Architect <esenese@proton.me>
Date: Fri, 2 Oct 2026 13:14:40 +0200
Subject: [PATCH 2/2] build: Take the commit hash from GIT_HASH when it is set

build.rs always runs `git rev-parse HEAD` and embeds its output as
GIT_HASH. A build from a source archive has no git checkout, so the
hash ends up empty, or, inside an unrelated checkout such as a
packaging repository, the hash of that checkout.

Use a non-empty GIT_HASH from the environment when there is one, and
only then fall back to git. Builds from a checkout are unchanged.
---
 build.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/build.rs b/build.rs
index b1cfaa9..696f656 100644
--- a/build.rs
+++ b/build.rs
@@ -2,7 +2,11 @@
 use std::process::Command;
 
 fn main() {
-    if let Ok(output) = Command::new("git").args(["rev-parse", "HEAD"]).output() {
+    // A build from a source archive has no git checkout: let the packager name the commit.
+    println!("cargo:rerun-if-env-changed=GIT_HASH");
+    if let Some(git_hash) = std::env::var("GIT_HASH").ok().filter(|hash| !hash.is_empty()) {
+        println!("cargo:rustc-env=GIT_HASH={}", git_hash);
+    } else if let Ok(output) = Command::new("git").args(["rev-parse", "HEAD"]).output() {
         let git_hash = String::from_utf8(output.stdout).unwrap();
         println!("cargo:rustc-env=GIT_HASH={}", git_hash);
     }
