msgstr "Account"

#: src/ui.rs:1070
msgid "Enter a user name of at most 256 bytes, without control characters."
msgstr "Inserisci un nome utente di al massimo 256 byte, senza caratteri di controllo."

#: src/ui.rs:1086
msgid "Signing in…"
msgstr "Accesso in corso…"

#: src/ui.rs:1101
msgid "Sign-in was cancelled."
msgstr "Accesso annullato."

#: src/ui.rs:1109
#, rust-format
msgid "Sign-in failed: {reason}"
msgstr "Accesso non riuscito: {reason}"

