msgid "Session"
msgstr "Sessione"

#: src/ui.rs:323
msgid "Athanor"
msgstr "Athanor"

#: src/ui.rs:326
msgid "Athanor on cosmic-comp"
msgstr "Athanor su cosmic-comp"

#: src/ui.rs:327
msgid "Workspace overview and Alt+Tab"
msgstr "Panoramica degli spazi di lavoro e Alt+Tab"

#: src/ui.rs:671
msgid "%A %-d %B"
msgstr "%A %-d %B"

