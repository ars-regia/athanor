[Unit]
Description=Collect garbage in the Nix store
Documentation=https://nix.dev/manual/nix/2.31/command-ref/new-cli/nix3-store-gc.html
# The store must be the writable /var/nix behind the /nix bind mount.
Requires=nix.mount nix-daemon.socket
After=nix.mount nix-daemon.socket athanor-nix-relabel.service

[Service]
Type=oneshot
# The daemon owns the store: it runs as root, deletes the paths and scans /proc for the
# runtime roots of every user's processes. This unit is only a client of its socket
# (CollectGarbage is open to every allowed user, and `allowed-users = *` in
# /usr/share/athanor/nix/daemon/nix.conf), so it holds no privilege at all.
Environment=NIX_REMOTE=daemon
Environment=NIX_CACHE_HOME=%C/athanor-nix-gc
DynamicUser=yes
CacheDirectory=athanor-nix-gc
NoNewPrivileges=yes
CapabilityBoundingSet=
# Deletes every store path no GC root reaches; profiles and their generations are roots,
# so nothing a user installed goes away.
# Fedora ships only /usr/bin/nix, not the legacy nix-store; the feature is named here so
# the collection does not depend on /etc/nix/nix.conf enabling it.
ExecStart=/usr/bin/nix --extra-experimental-features nix-command store gc
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
