[Unit]
Description=Nix Store bind mount from /var/nix
Documentation=https://github.com/ars-regia/athanor
# On this ostree system / is read-only, so the Nix store cannot live under /usr. It
# lives in /var/nix, which is writable and, on the installed system, the LUKS-encrypted
# home volume. This unit makes /nix a bind mount of /var/nix so every Nix tool sees a
# native store at /nix while the data persists in /var -- the approach bootc images use,
# rather than a symlink the store's own tooling can reject.
# DefaultDependencies=no is the crux. A .mount unit otherwise gets an automatic
# Before=local-fs.target. The store skeleton under /var/nix is created by
# systemd-tmpfiles-setup, which is After=local-fs.target, so this mount must run after it
# -- but with the implicit Before=local-fs.target that forms the cycle
# nix.mount -> tmpfiles-setup -> local-fs.target -> nix.mount, which systemd breaks by
# dropping the mount, leaving /nix unmounted (moving WantedBy to sysinit.target does not
# help: the implicit Before=local-fs.target stays). With DefaultDependencies=no that
# implicit ordering is gone, and the dependencies below are the only ones, giving the
# linear chain var mounted -> tmpfiles-setup -> nix.mount -> nix-daemon, no cycle.
DefaultDependencies=no
After=systemd-tmpfiles-setup.service
Before=nix-daemon.service nix-daemon.socket sysinit.target
Conflicts=umount.target
Before=umount.target
ConditionPathExists=/var/nix/store
RequiresMountsFor=/var

[Mount]
What=/var/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=sysinit.target
