[Unit]
Description=Athanor OS Pre-Boot GUI Recovery Kiosk
Documentation=https://github.com/ars-regia/athanor
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CPUWeight=100
MemoryHigh=768M
MemoryMax=1024M
OOMScoreAdjust=-100
Type=simple
# ProtectSystem=strict leaves the /run/user directory that pam_systemd exports read-only,
# and PAM's environment overrides Environment=: the kiosk gets its own RuntimeDirectory,
# passed on the command line so no merge order can replace it.
RuntimeDirectory=athanor-recovery
RuntimeDirectoryMode=0700
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user WLR_NO_HARDWARE_CURSORS=1
ExecStart=/usr/bin/env XDG_RUNTIME_DIR=/run/athanor-recovery /usr/bin/cosmic-comp --no-xwayland /usr/bin/athanor-recovery-ui
Restart=on-failure
RestartSec=5
User=athanor-recovery
Group=athanor-recovery
SupplementaryGroups=video input
# A logind session on seat0 gives cosmic-comp the DRM master and the input devices, as
# greetd does for the greeter. The session is active only on the foreground VT: the kiosk
# takes VT1, the one greetd held and left free when it hit its start limit.
PAMName=athanor-recovery
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=tty
StandardError=journal

# systemd hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc /var
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
LockPersonality=yes
SystemCallFilter=@system-service @mount

[Install]
WantedBy=athanor-recovery.target
