[Unit]
Description=Athanor session lock
# A guard (doc_session.md, SN6; doc_lock_and_prompts.md, LP10): it is never given up, because a
# lock that stays down leaves a dark locked screen with no way to unlock. It connects to the
# compositor, so it starts after the readiness gate and requires it (SN3).
After=graphical-session.target athanor-desktop.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/athanor-lock
# LP15: the lock draws with vello_cpu only. Sal's renderer switches would make this build, which
# has no gpu feature, refuse to start, so a value set in the user manager's environment never
# reaches it.
UnsetEnvironment=ATHANOR_SAL_RENDERER ATHANOR_TOOLKIT_RENDERER
# SN6: the RESTART_RESET=1 a guard sends after 60 s of healthy running reaches the manager.
NotifyAccess=main
Restart=always
RestartSec=100ms
RestartSteps=5
RestartMaxDelaySec=30s
Slice=session.slice
# MemoryMax= is set at spike L5's measurement plus 15% (LP15, ADR-0068), with LP18 step 2's
# VM test.

# D43 (#1558): no line that makes the user manager create a user namespace. Under a per-user
# manager ProtectSystem=, ProtectHome=, the Private*= and the ProtectKernel*= and
# ProtectControlGroups= lines put the service in one owned by the user, where a process of the
# same uid holds CAP_SYS_PTRACE and attaches to the lock whatever its dumpable flag. The lock
# confines its files and network in process (src/confine.rs); `verify.py separated-units` holds
# this unit to that. The lines below keep the host's user namespace (measured on systemd 262).
# LP15: Wayland, the system and session buses and athanor-unlockd's socket are all Unix sockets.
NoNewPrivileges=yes
# Without it a 32-bit socketcall through int 0x80 is not filtered, and opened a UDP socket past
# RestrictAddressFamilies=AF_UNIX (measured on systemd 262).
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Landlock does not mediate a change of a file's mode, owner, times or extended attributes, and
# the lock makes none: refused with EPERM, so a stray call fails instead of killing the guard.
SystemCallFilter=~@chown:EPERM chmod:EPERM fchmod:EPERM fchmodat:EPERM fchmodat2:EPERM utime:EPERM utimes:EPERM utimensat:EPERM futimesat:EPERM setxattr:EPERM lsetxattr:EPERM fsetxattr:EPERM setxattrat:EPERM removexattr:EPERM lremovexattr:EPERM fremovexattr:EPERM removexattrat:EPERM
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

# Installed and not enabled until LP18 step 3, the switch, adds its user preset.
[Install]
WantedBy=athanor-session.target
