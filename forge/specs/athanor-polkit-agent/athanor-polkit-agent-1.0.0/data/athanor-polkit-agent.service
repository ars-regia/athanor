[Unit]
Description=Athanor polkit authentication agent
# A guard (doc_session.md, SN6; doc_lock_and_prompts.md, LP11): a session without its agent
# cannot authorise, since polkit's fallback is off. It connects to the compositor, so it starts
# after the readiness gate and requires it (SN3).
After=graphical-session.target athanor-desktop.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
# Ready only once registered with polkit (doc_session.md, readiness; LP11).
Type=notify
ExecStart=/usr/bin/athanor-polkit-agent
# LP15: the agent draws with vello_cpu only. Sal's renderer switches would make this build, which
# has no gpu feature, refuse to start, so a value set in the user manager's environment never
# reaches it.
UnsetEnvironment=ATHANOR_SAL_RENDERER ATHANOR_TOOLKIT_RENDERER
# SN6: the RESTART_RESET=1 a guard sends after 60 s of healthy running reaches the manager.
NotifyAccess=main
Restart=always
RestartSec=100ms
RestartSteps=5
RestartMaxDelaySec=30s
Slice=session.slice
# LP11's value until spike L5's measurement plus 15% sets it (LP15, ADR-0068).
MemoryMax=96M

# D43 (#1558): no line that makes the user manager create a user namespace. Under a per-user
# manager ProtectSystem=, ProtectHome=, the Private*= and the ProtectKernel*= and
# ProtectControlGroups= lines put the service in one owned by the user, where a process of the
# same uid holds CAP_SYS_PTRACE and attaches to the agent whatever its dumpable flag. The agent
# confines its files and network in process, as the lock does; `verify.py separated-units` holds
# this unit to that. The lines below keep the host's user namespace (measured on systemd 262).
# LP11: Wayland, the system and session buses and polkit's helper are all Unix sockets.
NoNewPrivileges=yes
# Without it a 32-bit socketcall through int 0x80 is not filtered, and opened a UDP socket past
# RestrictAddressFamilies=AF_UNIX (measured on systemd 262).
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Landlock does not mediate a change of a file's mode, owner, times or extended attributes, and
# the agent makes none: refused with EPERM, so a stray call fails instead of killing the guard.
SystemCallFilter=~@chown:EPERM chmod:EPERM fchmod:EPERM fchmodat:EPERM fchmodat2:EPERM utime:EPERM utimes:EPERM utimensat:EPERM futimesat:EPERM setxattr:EPERM lsetxattr:EPERM fsetxattr:EPERM setxattrat:EPERM removexattr:EPERM lremovexattr:EPERM fremovexattr:EPERM removexattrat:EPERM
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

# Installed and not enabled until cosmic-osd's retirement adds its user preset (LP11; LP18 step
# 5; doc_osd.md, OD17 step 5).
[Install]
WantedBy=athanor-session.target
