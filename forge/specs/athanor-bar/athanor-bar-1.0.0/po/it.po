#: src/ui/shield.rs:296
msgid "System image verified"
msgstr "Immagine di sistema verificata"

#: src/ui/shield.rs:297
msgid "Not verified yet"
msgstr "Non ancora verificata"

#: src/ui/shield.rs:298
msgid "Update refused"
msgstr "Aggiornamento rifiutato"

#: src/ui/shield.rs:304
msgid "Signed with a key of the policy in force"
msgstr "Firmata con una chiave della policy in vigore"

#: src/ui/shield.rs:305
msgid "Not verified: installed from media"
msgstr "Non verificata: installata da supporto"

#: src/ui/shield.rs:306
msgid "Not verified: no signature"
msgstr "Non verificata: nessuna firma"

#: src/ui/shield.rs:307
msgid "Not verified: its key is not in the policy"
msgstr "Non verificata: la sua chiave non è nella policy"

#: src/ui/shield.rs:308
msgid "Not verified: fetched under a permissive policy"
msgstr "Non verificata: scaricata con una policy permissiva"

#: src/ui/shield.rs:309
msgid "Not verified: the image is outside the policy's scope"
msgstr "Non verificata: l'immagine è fuori dall'ambito della policy"

#: src/ui/shield.rs:310
msgid "Not verified: the system was changed on this machine"
msgstr "Non verificata: il sistema è stato modificato su questa macchina"

#: src/ui/shield.rs:316
msgid "Up to date"
msgstr "Aggiornato"

#: src/ui/shield.rs:317
msgid "An update is available; it downloads at the next check"
msgstr "È disponibile un aggiornamento; verrà scaricato al prossimo controllo"

#: src/ui/shield.rs:318
msgid "An update is ready; it installs when you restart"
msgstr "Un aggiornamento è pronto; si installa al riavvio"

#: src/ui/shield.rs:319
msgid "The update installs at the next restart"
msgstr "L'aggiornamento si installa al prossimo riavvio"

#: src/ui/shield.rs:320
msgid "The last update was refused by the policy"
msgstr "L'ultimo aggiornamento è stato rifiutato dalla policy"

#: src/ui/shield.rs:322
msgid "You went back from the newest version; only a newer one is offered"
msgstr "Sei tornato indietro dalla versione più recente; verrà proposta solo una versione più nuova"

#: src/ui/shield.rs:324
msgid "This version is older than one this machine has run"
msgstr "Questa versione è più vecchia di una già avviata su questa macchina"

#: src/ui/shield.rs:331
msgid "The last check failed: network error"
msgstr "L'ultimo controllo è fallito: errore di rete"

#: src/ui/shield.rs:332
msgid "The last check failed: registry error"
msgstr "L'ultimo controllo è fallito: errore del registry"

#: src/ui/shield.rs:333
msgid "The last check failed: refused by the policy"
msgstr "L'ultimo controllo è fallito: rifiutato dalla policy"

#: src/ui/shield.rs:334
msgid "The last check failed: storage error"
msgstr "L'ultimo controllo è fallito: errore di archiviazione"

#: src/ui/shield.rs:335
msgid "The last check failed: internal error"
msgstr "L'ultimo controllo è fallito: errore interno"

#: src/ui/shield.rs:341
msgid "No trust state yet: the first check has not run"
msgstr "Nessuno stato di fiducia: il primo controllo non è ancora avvenuto"

#: src/ui/shield.rs:343
msgid "The trust state file is not owned by the system and was ignored"
msgstr "Il file dello stato di fiducia non appartiene al sistema ed è stato ignorato"

#: src/ui/shield.rs:345
msgid "The trust state file could not be read"
msgstr "Impossibile leggere il file dello stato di fiducia"

#: src/ui/shield.rs:346 src/ui/shield.rs:360
msgid "The update service did not answer"
msgstr "Il servizio di aggiornamento non ha risposto"

#: src/ui/shield.rs:352
msgid "Not authorised"
msgstr "Non autorizzato"

#: src/ui/shield.rs:353
msgid "Another update request is running"
msgstr "È in corso un'altra richiesta di aggiornamento"

#: src/ui/shield.rs:355
msgid "Nothing is downloaded yet; the update downloads at the next check"
msgstr "Non c'è ancora nulla di scaricato; l'aggiornamento verrà scaricato al prossimo controllo"

#: src/ui/shield.rs:357
msgid "There is no previous version to go back to"
msgstr "Non c'è una versione precedente a cui tornare"

#: src/ui/shield.rs:358
msgid "A program is blocking the restart; close it and try again"
msgstr "Un programma impedisce il riavvio; chiudilo e riprova"

#: src/ui/shield.rs:359
msgid "The request failed; the system journal says why"
msgstr "La richiesta è fallita; il registro di sistema ne spiega il motivo"

