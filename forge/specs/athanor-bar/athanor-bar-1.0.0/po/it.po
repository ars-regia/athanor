#: src/ui/modules/shield.rs:501
msgid "Secure Boot on"
msgstr "Secure Boot attivo"

#: src/ui/modules/shield.rs:503
msgid "Secure Boot off: this machine runs in the declared degraded mode"
msgstr "Secure Boot disattivo: questa macchina funziona nella modalità degradata dichiarata"

#: src/ui/modules/shield.rs:507
msgid "Automatic security updates are off: security fixes wait until someone installs them."
msgstr "Gli aggiornamenti di sicurezza automatici sono disattivati: le correzioni di sicurezza aspettano che qualcuno le installi."

#: src/ui/modules/shield.rs:512
#, rust-format
msgid "The security update is postponed, at most until {time}; then it installs at the next shutdown or restart."
msgstr "L'aggiornamento di sicurezza è rimandato, al massimo fino al {time}; poi si installa al prossimo spegnimento o riavvio."

#: src/ui/modules/shield.rs:527
msgid "Go back to the previous version and restart? This asks for an administrator's password."
msgstr "Tornare alla versione precedente e riavviare? Serve la password di un amministratore."

#: src/ui/modules/shield.rs:528
msgid "Go back"
msgstr "Torna indietro"

#: src/ui/modules/shield.rs:531
msgid "Turn off automatic security updates? Security fixes will then wait until someone installs them, and this computer stays exposed until then. This applies to every user of this computer."
msgstr "Disattivare gli aggiornamenti di sicurezza automatici? Le correzioni di sicurezza aspetteranno che qualcuno le installi, e fino ad allora questo computer resta esposto. Vale per tutti gli utenti di questo computer."

#: src/ui/modules/shield.rs:532
msgid "Turn Off"
msgstr "Disattiva"

#: src/ui/modules/shield.rs:686
msgid "Automatic security updates"
msgstr "Aggiornamenti di sicurezza automatici"

#: src/ui/modules/shield.rs:690
msgid "Postpone"
msgstr "Rimanda"

#: src/ui/modules/shield.rs:694
msgid "Go back to the previous version"
msgstr "Torna alla versione precedente"

#: src/ui/modules/tiling.rs:63 src/ui/modules/tiling.rs:74
msgid "Tiling"
msgstr "Affiancamento"

#: src/ui/modules/tiling.rs:75
msgid "Tile windows"
msgstr "Affianca le finestre"

#: src/ui/modules/tray.rs:747
msgid "System tray"
msgstr "Vassoio di sistema"

