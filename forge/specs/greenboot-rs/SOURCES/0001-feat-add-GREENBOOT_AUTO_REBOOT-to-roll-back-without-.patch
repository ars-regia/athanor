+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use tempfile::TempDir;
+
+    fn config_with(contents: &str) -> GreenbootConfig {
+        let dir = TempDir::new().expect("cannot create temp dir");
+        let path = dir.path().join("greenboot.conf");
+        fs::write(&path, contents).expect("cannot write config");
+        GreenbootConfig::from_file(path.to_str().unwrap())
+    }
+
+    #[test]
+    fn test_auto_reboot_defaults_to_true_without_config_file() {
+        let config = GreenbootConfig::from_file("/nonexistent/greenboot.conf");
+        assert!(config.auto_reboot);
+        assert_eq!(config.max_reboot, 3);
+    }
+
+    #[test]
+    fn test_auto_reboot_defaults_to_true_when_key_is_absent() {
+        let config = config_with("GREENBOOT_MAX_BOOT_ATTEMPTS=5\n");
+        assert!(config.auto_reboot);
+        assert_eq!(config.max_reboot, 5);
+    }
+
+    #[test]
+    fn test_auto_reboot_false() {
+        let config = config_with("GREENBOOT_AUTO_REBOOT=false\n");
+        assert!(!config.auto_reboot);
+    }
+
+    #[test]
+    fn test_auto_reboot_true() {
+        let config = config_with("GREENBOOT_AUTO_REBOOT=true\n");
+        assert!(config.auto_reboot);
+    }
+
+    #[test]
+    fn test_auto_reboot_invalid_value_keeps_default() {
+        let config = config_with("GREENBOOT_AUTO_REBOOT=sometimes\n");
+        assert!(config.auto_reboot);
+    }
+
+    #[test]
+    fn test_auto_reboot_does_not_affect_other_keys() {
+        let config = config_with(
+            "GREENBOOT_MAX_BOOT_ATTEMPTS=2\nGREENBOOT_AUTO_REBOOT=false\nDISABLED_HEALTHCHECKS=(\"01_repository_dns_check.sh\")\n",
+        );
+        assert!(!config.auto_reboot);
+        assert_eq!(config.max_reboot, 2);
+        assert_eq!(
+            config.disabled_healthchecks,
+            vec!["01_repository_dns_check.sh"]
+        );
+    }
+}
