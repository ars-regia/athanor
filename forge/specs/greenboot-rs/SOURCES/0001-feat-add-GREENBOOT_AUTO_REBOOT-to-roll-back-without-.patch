+/// Handles a failed health check when GREENBOOT_AUTO_REBOOT is false.
+///
+/// Instead of spending boot attempts on reboots, the previous deployment is
+/// made the default right away, with the same rollback and the same cleanup
+/// as when the boot counter runs out, and nothing reboots: the next boot,
+/// whenever it is started, is the previous deployment, and greenboot on that
+/// boot reports the fallback. The rollback does not depend on GRUB's boot
+/// counter, which anything that sets boot_success=1 before that boot (such as
+/// grub-boot-success.timer in a user session) would cancel.
+fn rollback_without_reboot(previous_rollback: bool) -> Result<()> {
+    if get_next_deployment_id().unwrap_or(None).is_none() {
+        log::warn!(
+            "Health check failed but no next-deployment-id set - manual intervention required"
+        );
+        bail!("Manual intervention required - no rollback trigger");
+    }
+
+    log::info!(
+        "GREENBOOT_AUTO_REBOOT is false - queueing the previous deployment for the next boot without rebooting"
+    );
+    match handle_rollback(RollbackMode::Forced) {
+        Ok(()) => {
+            log::info!("Rollback successful");
+            with_boot_rw(|| {
+                unset_boot_counter()?;
+                unset_next_deployment_id()?;
+                Ok(())
+            })
+            .unwrap_or_else(|e| log::error!("Failed to clear grub vars: {e}"));
+            handle_motd(&generate_motd_message(
+                "Greenboot healthcheck failed - status is RED. The previous deployment will boot at the next restart",
+                previous_rollback,
+            )?)
+            .unwrap_or_else(|e| log::error!("cannot set motd: {e}"));
+            bail!("greenboot healthcheck failed")
+        }
+        Err(rollback_err) => {
+            log::error!("Rollback failed: {rollback_err}");
+            bail!("Manual intervention required - rollback failed");
+        }
+    }
+}
