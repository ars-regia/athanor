[Unit]
Description=Athanor wallpaper
# In the class of the surfaces (doc_session.md, SN6; doc_session_daemons.md, SD17): it restarts
# on failure, and a loop leaves it failed until the next login. It connects to the compositor,
# so it starts after the readiness gate and requires it (SN3), as cosmic-bg.service did.
After=graphical-session.target athanor-desktop.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target
# The decoder's socket: each picture is handed to an instance of athanor-wallpaper-decode@.service
# (SD17), so the socket listens before the daemon asks for its first picture.
Wants=athanor-wallpaper-decode.socket
After=athanor-wallpaper-decode.socket
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# Ready once every surface has drawn its first frame, a plain colour until the pixels arrive.
Type=notify
ExecStart=/usr/bin/athanor-wallpaper
TimeoutStartSec=20s
Restart=on-failure
RestartSec=100ms
# The decoder admits only a peer in this unit of session.slice (SD17).
Slice=session.slice
# No MemoryMax=: row W4 of SD22 asks for one only as measured at 8K, and it was not measured.

# "dconf" because GSettings maps dconf's shared-memory flag beneath %t/dconf read-write to
# learn that a key changed, as xdg-desktop-portal-athanor.service explains; every GSettings
# client of the session shares it, hence the preserve. Landlock grants the same path once it
# is private (athanor_unit::dirs::private_dir, SD17).
RuntimeDirectory=dconf
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

ProtectSystem=strict
# The user's pictures are read beneath the home directory.
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
# Sal draws with vello_cpu, without the gpu feature (SD6).
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Wayland, both D-Buses, journald and the decoder's socket, all over Unix sockets.
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=athanor-session.target
