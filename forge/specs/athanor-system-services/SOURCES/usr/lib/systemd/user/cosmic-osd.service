[Unit]
Description=COSMIC on-screen display
Documentation=https://github.com/pop-os/cosmic-osd
After=graphical-session.target athanor-desktop.service
Requisite=athanor-desktop.service
PartOf=graphical-session.target

[Service]
# W^X cannot hold for a GL client: Mesa JIT-compiles shaders on the CPU wherever there
# is no GPU driver (llvmpipe, the case of every VM); acceptance run 34524538068 saw every
# start of a GL client segfault at the first JIT'd function with it on. mincore is the
# one call Mesa's allocator adds to @system-service.
MemoryDenyWriteExecute=no
MemoryHigh=256M
MemoryMax=384M
Type=simple
Slice=session.slice
ExecStart=/usr/bin/cosmic-osd
Restart=on-failure
RestartSec=2s

ProtectSystem=strict
ProtectHome=read-only
ConfigurationDirectory=cosmic
StateDirectory=cosmic
PrivateTmp=true
NoNewPrivileges=true
SystemCallFilter=@system-service mincore
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
