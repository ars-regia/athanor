[Unit]
Description=Athanor OS desktop session
Documentation=https://github.com/hr-mes/athanor-forge

# The session manager's target: it stands and falls with graphical-session.target and
# comes up after the pre target; XDG autostart entries run once it is up.
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target

# COSMIC's own services are pulled in from here; our shell (athanor-bar, athanor-dock,
# athanor-shelld) is enabled by user presets, so a user can mask it. A target is ordered
# after the units it wants, so this one is active once the desktop units are up;
# it is not ordered before graphical-session.target, which the units come after, as
# that would be a cycle. athanor-desktop starts this target once the compositor has a
# display and waits on it; stopping it ends the session.
# The readiness gate: the target does not count as up until the compositor answers,
# and the desktop units below are ordered after it.
Requires=athanor-desktop.service
After=athanor-desktop.service
Wants=athanor-skel-sync.service cosmic-bg.service
Wants=cosmic-settings-daemon.service cosmic-osd.service
