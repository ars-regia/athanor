#!/usr/bin/sh
# athanor-greeter-session - starts the greeter compositor for greetd.
#
# greetd runs this as the greetd user with the environment PAM built and nothing else:
# greetd's own environment, and with it anything a greetd.service drop-in would set,
# never reaches the session (greetd 0.10.3, session/worker.rs: execve is given
# pam_getenvlist and nothing more). Whatever the compositor needs is set here.

set -eu

# pam_systemd sets XDG_RUNTIME_DIR when logind registers the session; this is only for
# the case where it did not, /run/user itself always being there.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    mkdir -m 0700 "$XDG_RUNTIME_DIR"
fi

# The greeter speaks the system's language. Its own strings find /etc/locale.conf by
# themselves (athanor-i18n); GTK's strings and the date's weekday and month names come
# from glibc, which needs the variables. systemd applies locale.conf to services, but
# greetd hands a session only PAM's environment. The file is parsed, never sourced: only
# the locale variables are taken, and only values made of the characters a locale name
# uses, so nothing in it runs in the process that starts the compositor.
if [ -r /etc/locale.conf ]; then
    while IFS='=' read -r variable value || [ -n "$variable" ]; do
        case $variable in
        LANG | LANGUAGE | LC_MESSAGES | LC_TIME) ;;
        *) continue ;;
        esac
        # systemd's format allows the value in quotes.
        value=${value#\"}
        value=${value%\"}
        value=${value#\'}
        value=${value%\'}
        case $value in
        '' | *[!A-Za-z0-9_.@:-]*) continue ;;
        esac
        export "$variable=$value"
    done < /etc/locale.conf
fi

# GTK 4.20's wayland input-method module, which GTK 4 picks whenever the compositor
# offers text-input-v3, composes nothing by itself: with no input method running,
# dead keys and Compose sequences are dropped (US-International loses every accent).
# The simple module composes them. The greeter runs no input method
# (doc_languages.md LN10), and a password typed with dead keys must arrive whole.
export GTK_IM_MODULE=simple

# cosmic-comp given a program runs it as its client on a display of its own and exits
# when it exits, the way cosmic-greeter-start uses it and the way cage was used here;
# greetd then starts the session on the freed VT. Without WAYLAND_DISPLAY or DISPLAY in
# the environment, and greetd sets neither, it takes the seat through logind and draws
# on KMS. The greeter has no use for an X server, so none is started for it.
#
# systemd-cat puts the compositor's own output in the journal under "athanor-greeter".
# Without it the session's stderr goes nowhere greetd keeps, and when the greeter fails
# all that survives is greetd's "greeter exited without creating a session", which says
# that something went wrong and nothing about what.
#
# The client is athanor-greeter-client, which runs the greeter UI in a sandbox and never
# unconfined; the compositor itself stays outside it. The wrapper explains the model.
exec systemd-cat -t athanor-greeter cosmic-comp --no-xwayland /usr/libexec/athanor-greeter-client
