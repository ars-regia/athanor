#!/bin/sh
# Athanor OS USBGuard session lock state toggle
case "$1" in
    lock)
        # Block any newly inserted USB devices during screen lock / greeter
        usbguard set-parameter InsertedDevicePolicy block
        ;;
    unlock)
        # Restore normal policy evaluation for authenticated active session
        usbguard set-parameter InsertedDevicePolicy apply-policy 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {lock|unlock}"
        exit 1
        ;;
esac
