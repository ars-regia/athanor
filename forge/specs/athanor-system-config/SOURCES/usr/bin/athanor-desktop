#!/usr/bin/sh
# athanor-desktop - cosmic-comp's client for the session.
#
# cosmic-comp hands its client WAYLAND_DISPLAY (and DISPLAY, for Xwayland) and exits when
# the client exits, so this process is the session's anchor. It is the only process that
# has the compositor's WAYLAND_DISPLAY in its environment, so it is the one that must
# publish it to the user manager -- a unit started by the manager inherits the manager's
# environment, not this script's. It then starts the desktop through
# athanor-session.target and waits on it.
#
# The target requires athanor-desktop.service, the readiness gate, which blocks until the
# compositor answers a Wayland round-trip, so no graphical unit starts before cosmic-comp
# can serve a surface. The session lasts exactly as long as the target is active, and
# `systemctl --user stop athanor-session.target` is the logout: the wait returns, this
# process exits, cosmic-comp exits, greetd shows the greeter again.
#
# The screen locker and the idle daemon run as children of the session's supervisor,
# each in its own scope, shared with the own compositor's session
# (/usr/libexec/athanor/session-components; doc_session.md, SN15).
set -eu
# localsearch's unit starts only with XDG_SESSION_CLASS=user (ConditionEnvironment=), and
# greetd hands the session no class: read it from logind and publish it with the rest.
if [ -n "${XDG_SESSION_ID:-}" ] && class=$(loginctl show-session "$XDG_SESSION_ID" --property=Class --value); then
	export XDG_SESSION_CLASS="$class"
else
	echo "athanor-desktop: cannot read the session class from logind; file search stays off" >&2
fi
# The import list is one file, which the readiness gate's ExecStop= reads to unset the same
# names at the end of the session (doc_session.md, SN2). A name this script's environment
# does not hold is skipped, so the manager keeps its own value. XDG_CURRENT_DESKTOP already
# reaches the manager, before any unit starts, from /usr/lib/environment.d/50-athanor-desktop.conf;
# importing it again republishes the value athanor-session exported, which is the same one.
# The reader refuses a list it cannot read or that names no valid variable, since systemctl
# given no name would import this script's whole environment.
# shellcheck source=SCRIPTDIR/../libexec/athanor/session-import-names
. /usr/libexec/athanor/session-import-names
names=$(session_import_names /usr/share/athanor-system-config/session-import)
# shellcheck disable=SC2086 # one word per name, each one validated by the reader
systemctl --user import-environment $names

# The locker and the idle daemon, at once: cosmic-comp already serves. The anchor is this
# process, whose PID stays the same once it execs systemctl below.
# shellcheck source=SCRIPTDIR/../libexec/athanor/session-components
. /usr/libexec/athanor/session-components
session_components "$$" &

exec systemctl --user start --wait athanor-session.target
