[Unit]
Description=Update the system Flatpak applications
Documentation=https://github.com/ars-regia/athanor/blob/iso-v0/docs/architecture/doc_software.md
After=network-online.target
Wants=network-online.target
# The triggers also run after a failed update: an update that installed some applications and
# failed on another (an apply_extra that cannot run) has still changed the exports, and the
# caches would otherwise stay stale on every run.
OnSuccess=athanor-flatpak-triggers.service
OnFailure=athanor-flatpak-triggers.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/athanor-flatpak-update
# A oneshot has no start timeout by default: a pull that stalls would keep the unit active, and
# the timer would skip every later run. A stalled update fails instead, and OnFailure= runs.
TimeoutStartSec=4h
# Flatpak runs its triggers in bubblewrap, which needs CAP_SYS_ADMIN as root (and would fail
# here without a word). An empty triggers directory makes it run none; the unit above does.
Environment=FLATPAK_TRIGGERSDIR=/usr/share/athanor-system-config/flatpak-no-triggers
# ProtectHome hides /root, where GLib would put dconf's cache and warn on every run.
Environment=GSETTINGS_BACKEND=memory
# doc_software.md, decision 6 (i) and SW15. The system installation only; the unit reaches
# the network (Flathub) and the system bus (NetworkManager's Metered), nothing else.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/flatpak /var/tmp
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID
# The network (AF_NETLINK for getaddrinfo's interface query) and local sockets (the system bus,
# gpg-agent for the remote's signatures); no other address family.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# A call outside the set fails with EPERM, as it already does for want of CAP_SYS_ADMIN (the
# bubblewrap of an apply_extra), instead of killing the update.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# Not set: UMask=0077, which would leave the installed applications unreadable to their users;
# ProcSubset=pid, which hides /proc/sys/kernel/random/boot_id that OSTree opens the repository
# with; and RestrictNamespaces=, which waits on a test of apply_extra's bubblewrap (#478).
