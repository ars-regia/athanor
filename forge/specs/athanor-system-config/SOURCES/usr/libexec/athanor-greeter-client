#!/usr/bin/sh
# athanor-greeter-client - runs the greeter UI inside a sandbox built from outside it.
#
# Confinement model. greetd starts athanor-greeter-session in the greeter's logind
# session; that script runs cosmic-comp, and cosmic-comp runs this wrapper as its only
# client. The compositor stays unconfined: it takes the seat through logind and needs
# the DRM and input devices the session was granted. Only the client that reads the
# password is confined, and the confinement is applied here, before it executes, so
# nothing in its own code has to cooperate. greetd.service itself carries no sandboxing
# on purpose: systemd applies a unit's sandboxing to every process the unit starts, so a
# restriction on greetd would also bind the compositor and every user session greetd
# launches, where it broke rootless containers and read-only /proc/sys.
#
#   - bubblewrap sets PR_SET_NO_NEW_PRIVS and, unprivileged, runs the client with no
#     capabilities in a user namespace of its own, together with new PID, IPC, UTS,
#     cgroup and network namespaces. The client has no network: every socket it talks
#     to is a filesystem socket bound in below.
#   - The filesystem is empty except for what is bound in: /usr and /etc read-only,
#     sysfs read-only and the DRM nodes for rendering, the Wayland socket of this
#     compositor, greetd's IPC socket ($GREETD_SOCK), a filtered system bus and the
#     AccountsService avatars. /tmp, $HOME and $XDG_RUNTIME_DIR are private tmpfs
#     mounts. No home directory, no /var.
#   - The system bus is not the real one. The process that reads the password would
#     otherwise hold every call polkit grants an active local session (udisks2,
#     NetworkManager, ...). xdg-dbus-proxy runs outside the sandbox, as the same user, and
#     the greeter sees only its socket, which forwards three methods and nothing else:
#     Suspend, Reboot and PowerOff of org.freedesktop.login1.Manager on
#     /org/freedesktop/login1, the calls behind the greeter's power buttons. The rest of
#     logind stays out of reach -- before anyone has authenticated, polkit's defaults for
#     an active local session would otherwise let the greeter pick the boot loader entry
#     or firmware setup for the next boot, take inhibitors or lock sessions. Nothing
#     else is asked of the system bus.
#   - The session bus is filtered the same way, for accessibility: the greeter may own
#     its GApplication name and talk to org.a11y.Bus, which hands out the address of the
#     AT-SPI bus, and that bus's socket alone is bound read-only, so a screen reader can
#     reach the greeter. The greetd user's session bus comes from the
#     user manager logind starts for the greeter session; where there is none, the
#     greeter runs without accessibility and says so in the journal.
#   - --die-with-parent ends the client with the compositor, and --new-session keeps it
#     off the compositor's terminal.
#
# Nested user namespaces stay allowed: gdk-pixbuf decodes images through glycin, whose
# loaders run in bubblewrap sandboxes of their own.
#
# Fail closed: the greeter is only ever exec'd by bwrap. If a required socket is missing,
# the D-Bus proxy does not come up or bwrap cannot build the sandbox, this script exits
# non-zero, cosmic-comp exits with its client and greetd reports that the greeter failed.
# There is no unconfined path.

set -eu

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
: "${WAYLAND_DISPLAY:?WAYLAND_DISPLAY is not set: not started by the compositor}"
: "${GREETD_SOCK:?GREETD_SOCK is not set: not started by greetd}"
: "${HOME:?HOME is not set}"

# WAYLAND_DISPLAY is a socket name relative to XDG_RUNTIME_DIR, or an absolute path.
case "$WAYLAND_DISPLAY" in
    /*) wayland_socket=$WAYLAND_DISPLAY ;;
    *) wayland_socket=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ;;
esac

for socket in "$wayland_socket" "$GREETD_SOCK" /run/dbus/system_bus_socket; do
    if [ ! -S "$socket" ]; then
        echo "athanor-greeter-client: $socket is not a socket, refusing to start" >&2
        exit 1
    fi
done

# The proxy's sockets live in a directory of this user's runtime directory, recreated at
# every start so that a previous greeter's sockets never linger. Readiness comes from
# xdg-dbus-proxy's --fd: it writes one byte to that descriptor once it listens, and exits
# when the other end is closed. The other end is a FIFO this script opens for reading and
# hands to bwrap with --sync-fd, so the proxy lives exactly as long as the sandbox.
dbus_dir=$XDG_RUNTIME_DIR/athanor-greeter-dbus
rm -rf "$dbus_dir"
mkdir -m 0700 "$dbus_dir"
mkfifo "$dbus_dir/ready"
set -- unix:path=/run/dbus/system_bus_socket "$dbus_dir/system" \
    --filter \
    --call=org.freedesktop.login1=org.freedesktop.login1.Manager.Suspend@/org/freedesktop/login1 \
    --call=org.freedesktop.login1=org.freedesktop.login1.Manager.Reboot@/org/freedesktop/login1 \
    --call=org.freedesktop.login1=org.freedesktop.login1.Manager.PowerOff@/org/freedesktop/login1
session_bus=$XDG_RUNTIME_DIR/bus
if [ -S "$session_bus" ]; then
    set -- "$@" "unix:path=$session_bus" "$dbus_dir/session" \
        --filter --own=os.athanor.Greeter --talk=org.a11y.Bus
fi
xdg-dbus-proxy --fd=3 "$@" 3> "$dbus_dir/ready" &
exec 4< "$dbus_dir/ready"
if [ "$(head -c 1 <&4)" != x ] || [ ! -S "$dbus_dir/system" ] ||
    { [ -S "$session_bus" ] && [ ! -S "$dbus_dir/session" ]; }; then
    echo "athanor-greeter-client: xdg-dbus-proxy did not start, refusing to start" >&2
    exit 1
fi

# The binds that depend on this machine and this session, collected in the positional
# parameters and appended to the fixed ones below.
set --
if [ -S "$dbus_dir/session" ]; then
    set -- "$@" --ro-bind "$dbus_dir/session" "$session_bus" \
        --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$session_bus"
    # Asking for the address starts the AT-SPI bus when it is not running yet, so its
    # socket exists before the sandbox is built.
    if atspi_address=$(busctl --timeout=5 --address="unix:path=$session_bus" call \
        org.a11y.Bus /org/a11y/bus org.a11y.Bus GetAddress); then
        atspi_socket=$(printf '%s\n' "$atspi_address" | sed -n 's/^s "unix:path=\([^,"]*\).*/\1/p')
    else
        atspi_socket=
    fi
    # Only the socket file is bound, and only from at-spi-bus-launcher's own directory: a
    # read-only bind still accepts connect(), so binding a directory, or a socket
    # anywhere else in the runtime directory, could hand the greeter the unfiltered
    # session bus next to it.
    case "$atspi_socket" in
        "$XDG_RUNTIME_DIR"/at-spi/*/* | "$XDG_RUNTIME_DIR"/at-spi/*..*) atspi_socket= ;;
        "$XDG_RUNTIME_DIR"/at-spi/?*) ;;
        *) atspi_socket= ;;
    esac
    if [ -S "$atspi_socket" ]; then
        set -- "$@" --ro-bind "$atspi_socket" "$atspi_socket"
    else
        echo "athanor-greeter-client: no AT-SPI bus socket in $XDG_RUNTIME_DIR/at-spi, the greeter runs without accessibility" >&2
    fi
else
    echo "athanor-greeter-client: no session bus at $session_bus, the greeter runs without accessibility" >&2
fi
# The NVIDIA driver's device nodes, for the -nvidia image variants: the control and
# modeset nodes by name, one numbered node per GPU. A node that does not exist is skipped.
# The nvidia-uvm nodes serve CUDA only and stay out: the greeter renders without them, and
# they are created late with a generic SELinux label that xdm_t may not stat, which bwrap
# treats as fatal and which left the machine at a black screen.
for node in /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia[0-9]*; do
    set -- "$@" --dev-bind-try "$node" "$node"
done

# /dev/dri is absent on a machine with no DRM driver at all, where GTK renders in
# software: its bind is optional, like the udev database, the avatar and font cache
# directories.
# /sys is bound by the device-tree directories libdrm, udev and the GPU drivers read,
# the set Flatpak exposes, rather than whole: a recursive read-only bind of /sys would
# also carry efivarfs, securityfs, tracefs, bpffs, pstore and the cgroup tree, and
# SELinux refuses xdm_t the remount that makes each of those read-only.
exec bwrap \
    --unshare-all \
    --die-with-parent \
    --new-session \
    --cap-drop ALL \
    --ro-bind /usr /usr \
    --symlink usr/bin /bin \
    --symlink usr/sbin /sbin \
    --symlink usr/lib /lib \
    --symlink usr/lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --dev-bind-try /dev/dri /dev/dri \
    --ro-bind /sys/block /sys/block \
    --ro-bind /sys/bus /sys/bus \
    --ro-bind /sys/class /sys/class \
    --ro-bind /sys/dev /sys/dev \
    --ro-bind /sys/devices /sys/devices \
    --ro-bind-try /run/udev /run/udev \
    --tmpfs /tmp \
    --ro-bind-try /var/cache/fontconfig /var/cache/fontconfig \
    --ro-bind-try /var/lib/AccountsService/icons /var/lib/AccountsService/icons \
    --symlink ../run /var/run \
    --ro-bind "$dbus_dir/system" /run/dbus/system_bus_socket \
    --ro-bind "$GREETD_SOCK" "$GREETD_SOCK" \
    --tmpfs "$HOME" \
    --perms 0700 --tmpfs "$XDG_RUNTIME_DIR" \
    --ro-bind "$wayland_socket" "$wayland_socket" \
    "$@" \
    --sync-fd 4 \
    --chdir / \
    -- /usr/bin/athanor-greeter-ui
