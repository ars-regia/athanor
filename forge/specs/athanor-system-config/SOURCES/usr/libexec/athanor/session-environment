# shellcheck shell=sh
# session-environment - the user's language, region and cursor (doc_session.md SN2;
# doc_languages.md LN6 and LN7; doc_accessibility.md AX9), sourced by athanor-session
# (cosmic-comp's session) and by athanor-compositor-session (the own compositor's), so that
# both sessions export the same values, which the import list carries into the user manager.
# It defines functions and runs nothing.

# note <message>: one warning in the journal under the sourcing script's name; when
# systemd-cat cannot write it, the message goes to stderr.
note() {
    if ! printf '%s\n' "$1" | systemd-cat -p warning -t "${0##*/}"; then
        printf '%s: %s\n' "${0##*/}" "$1" >&2
    fi
}
# A locale name, checked against LN6's characters, as athanor-greeter-session checks those
# of /etc/locale.conf.
is_locale() {
    case $1 in
    '' | *[!A-Za-z0-9_.@-]*) return 1 ;;
    esac
}
# The value of a GSettings string key, which gsettings prints in single quotes.
gsetting_string() {
    value=$(gsettings get "$1" "$2") || return 1
    case $value in
    \'*\')
        value=${value#\'}
        value=${value%\'}
        ;;
    *) return 1 ;;
    esac
    case $value in
    *[\'\\]*) return 1 ;;
    esac
    printf '%s\n' "$value"
}

# export_user_environment: exports LANG, LANGUAGE, the LC_* formats of the region and
# XCURSOR_SIZE and XCURSOR_THEME. A value that cannot be read or fails its check is logged
# and ignored, and the system's applies; nothing here fails the caller. LN7's hand-off from
# first run, athanor-first-run apply-handoff, comes before these reads with the command itself
# (doc_first_run.md, step 4 of its construction).
export_user_environment() {
    # LN6: LANG from the first of AccountsService's Languages, LANGUAGE from the list when it
    # has more than one entry. AccountsService names the user's object; busctl prints its
    # type and the path in quotes, then for Languages the variant's type, the array's type,
    # the count and each entry in quotes. Both are method calls, which busctl's --timeout
    # bounds to 2 s, so a stalled AccountsService cannot hold the login; get-property would
    # ignore --timeout and wait the bus's 25 s default (systemd 258).
    if user=$(busctl --timeout=2 --system call org.freedesktop.Accounts /org/freedesktop/Accounts \
        org.freedesktop.Accounts FindUserById x "$(id -u)") &&
        case $user in
        'o "/org/freedesktop/Accounts/'*\") user=${user#o \"} ;;
        *) false ;;
        esac &&
        languages=$(busctl --timeout=2 --system call org.freedesktop.Accounts "${user%\"}" \
            org.freedesktop.DBus.Properties Get ss org.freedesktop.Accounts.User Languages); then
        set -f
        # shellcheck disable=SC2086 # one word per entry
        set -- $languages
        set +f
        list=
        if [ "$#" -ge 3 ] && [ "$1" = v ] && [ "$2" = as ]; then
            shift 3
            for entry do
                language=${entry#\"}
                language=${language%\"}
                if [ "\"$language\"" = "$entry" ] && is_locale "$language"; then
                    list=${list:+$list:}$language
                else
                    note "ignoring the language $entry of AccountsService"
                fi
            done
        else
            note "cannot parse the languages AccountsService gave: $languages"
        fi
        if [ -n "$list" ]; then
            export LANG="${list%%:*}"
            case $list in
            *:*) export LANGUAGE="$list" ;;
            esac
        fi
    else
        note "cannot read the languages from AccountsService; the system's apply"
    fi

    # LN7: the region's formats, when the region is set and differs from LANG, as gnome-session
    # applies them.
    if region=$(gsetting_string org.gnome.system.locale region); then
        if [ -n "$region" ] && ! is_locale "$region"; then
            note "ignoring the region $region"
        elif [ -n "$region" ] && [ "$region" != "${LANG-}" ]; then
            export LC_NUMERIC="$region" LC_TIME="$region" LC_MONETARY="$region" LC_PAPER="$region"
            export LC_ADDRESS="$region" LC_TELEPHONE="$region" LC_MEASUREMENT="$region"
        fi
    else
        note "cannot read the region from GSettings, or it is not one string; the language's formats apply"
    fi

    # AX9: the cursor's size and theme, for the compositor and the applications.
    if size=$(gsettings get org.gnome.desktop.interface cursor-size); then
        case $size in
        '' | *[!0-9]*) note "ignoring the cursor size $size" ;;
        *) export XCURSOR_SIZE="$size" ;;
        esac
    else
        note "cannot read the cursor size from GSettings"
    fi
    if theme=$(gsetting_string org.gnome.desktop.interface cursor-theme); then
        if [ -n "$theme" ]; then
            export XCURSOR_THEME="$theme"
        fi
    else
        note "cannot read the cursor theme from GSettings, or it is not one string"
    fi
}
