[Unit]
Description=Athanor OS Local AI & Machine Learning Inference Daemon
Documentation=https://github.com/hr-mes/athanor
After=network-online.target dbus.service
Requires=dbus.service

[Service]
MemoryDenyWriteExecute=true
CPUWeight=100
CPUQuota=200%
MemoryHigh=3072M
MemoryMax=4096M
OOMScoreAdjust=100
CapabilityBoundingSet=CAP_IPC_LOCK CAP_SYS_NICE
AmbientCapabilities=CAP_IPC_LOCK CAP_SYS_NICE
Type=dbus
BusName=os.athanor.AiDaemon
ExecStart=/usr/bin/athanor-ai-daemon
Restart=always
RestartSec=5s

DynamicUser=yes


# Extreme Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
NoNewPrivileges=yes
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
