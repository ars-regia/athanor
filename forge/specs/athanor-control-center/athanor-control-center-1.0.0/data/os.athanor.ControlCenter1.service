# doc_control_center.md, CC2: a call to os.athanor.ControlCenter1 starts the control center's
# unit when it is down, so the bar's button and Super+C open it on demand. Super+C is bound
# at login by athanor-control-center-shortcut.service, not by this activation. The bus never
# runs the program itself.
[D-BUS Service]
Name=os.athanor.ControlCenter1
Exec=/bin/false
SystemdService=athanor-control-center.service
