[Unit]
Description=Athanor control center: bind Super+C
Documentation=https://github.com/ars-regia/athanor/blob/iso-v0/docs/architecture/doc_control_center.md
# doc_control_center.md, CC9: the panel starts on the first call to os.athanor.ControlCenter1,
# so on a new account nothing would bind Super+C before the bar's button was used. This
# oneshot binds it at login, once per user (the marker lives in the panel's state directory),
# and exits before GTK and before the panel claims its bus name.
After=graphical-session.target athanor-desktop.service
PartOf=graphical-session.target
# Not in the preview session on the own compositor (doc_session.md, SN15), whose script alone
# sets ATHANOR_PREVIEW_SESSION in the user manager: Super+C goes into cosmic-comp's shortcuts,
# which the own compositor does not read (SN16, gap 7).
ConditionEnvironment=!ATHANOR_PREVIEW_SESSION

[Service]
Type=oneshot
ExecStart=/usr/bin/athanor-control-center --bind-shortcut
Slice=session.slice
# ~/.local/state/athanor/control-center: the Super+C marker.
StateDirectory=athanor/control-center
# cosmic-comp's shortcuts, the one write this unit makes.
ConfigurationDirectory=cosmic/com.system76.CosmicSettings.Shortcuts/v1
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=athanor-session.target
