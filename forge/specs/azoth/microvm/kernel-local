# Guest kernel for the MicroVMs (docs/architecture/doc_kernel_build.md, section 9): the
# fragment that build.sh merges on top of x86_64_defconfig + kvm_guest.config, same
# source and same pin as the main kernel. Same format as kernel-local: every line must
# hold in the generated config (check_delta), one line of rationale per option.

# Identity: uname -r ends in -microvm, without the git suffix.
CONFIG_LOCALVERSION="-microvm"
# CONFIG_LOCALVERSION_AUTO is not set
# No modules: everything built-in, a single file to load and to attest.
# CONFIG_MODULES is not set
# The config inside the kernel: it is what the attestation and the gate read at runtime.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Virtio: MMIO bus (Firecracker enumerates the devices from the command line) and PCI
# (cloud-hypervisor); disks, network, console, vsock for hypervisor-daemon, rng, balloon.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y

# File systems: 9p and virtiofs for the directories shared by the host, EROFS for the
# immutable rootfs (like the system), overlay for the writable layer, ext4 for volumes.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
# dm-verity: the guest rootfs is verified like the host's.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# BPF with BTF, as in the main kernel: observability and policy in the guest as well.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y

# Hardening of the main kernel that also holds in a guest: kCFI (clang), Landlock.
CONFIG_CFI=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
# Confidential guests, for the hosts that have them.
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_INTEL_TDX_GUEST=y

# The console is the serial port that Firecracker and cloud-hypervisor expose.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# No ACS override, as in the main kernel: the CachyOS 7.3 tree turns it on by default.
# CONFIG_PCI_ACS_OVERRIDE is not set

# No physical drivers: out with what defconfig turns on for real machines.
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_ATA is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_I2C is not set
# CONFIG_AGP is not set
# THERMAL and HWMON stay: ACPI (which cloud-hypervisor and Firecracker use to enumerate
# the devices) and the x86 platform select them; without sensors they do nothing.
