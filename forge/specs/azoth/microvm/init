#!/bin/sh
# PID 1 of the test rootfs of gate K6 (microvm/boot.sh): assertions on the guest kernel
# in Firecracker, verdict on the serial console, then reboot (with reboot=k that is how
# Firecracker exits). Every check prints `K6 ok` or `K6 FAIL`, the final line `K6 RESULT ok|FAIL`.
mount -t proc proc /proc
mount -t sysfs sys /sys
grep -q ' /dev devtmpfs ' /proc/mounts || mount -t devtmpfs dev /dev
exec > /dev/console 2>&1

fail=0
check() { # check NAME COMMAND...: prints the verdict and the output of the command
  name=$1; shift
  if out=$("$@" 2>&1); then echo "K6 ok   $name: $out"; else echo "K6 FAIL $name: $out"; fail=1; fi
}
release=$(sed -n 's/.*k6\.release=\([^ ]*\).*/\1/p' /proc/cmdline)

check uname sh -c "[ \"\$(uname -r)\" = '$release' ] && uname -r"
check root sh -c 'grep -E "^/dev/(root|vda) / ext4 " /proc/mounts'
check btf sh -c 'test -e /sys/kernel/btf/vmlinux && echo "$(wc -c < /sys/kernel/btf/vmlinux) bytes"'
check filesystems sh -c 'for fs in erofs 9p virtiofs overlay ext4; do grep -qw "$fs" /proc/filesystems || exit 1; done; echo "erofs 9p virtiofs overlay ext4"'
check device-mapper sh -c 'grep -q " device-mapper$" /proc/devices && test -e /dev/mapper/control && echo "/dev/mapper/control"'
check config sh -c 'zcat /proc/config.gz | grep -x "CONFIG_DM_VERITY=y\|CONFIG_CFI=y\|CONFIG_VIRTIO_VSOCKETS=y" | tr "\n" " "'
check no-modules sh -c 'test ! -e /proc/modules && echo "no modules"'
check dmesg sh -c '! dmesg | grep -E "BUG: |kernel BUG at|WARNING: CPU: |Oops: |Call Trace:|cut here" && echo clean'

if [ $fail = 0 ]; then echo "K6 RESULT ok"; else echo "K6 RESULT FAIL"; fi
sync
reboot -f
