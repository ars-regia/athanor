# Athanor OS: environment of the kernel signing step (docs/architecture/doc_kernel_profile.md,
# D43). system/sign-kernel.sh runs it in the sign-only job that holds the Secure Boot key:
# rpm2cpio and cpio extract vmlinuz from the kernel-core RPM, sbsigntools replaces the
# package's test signature with the project's and verifies the result. Nothing else: the
# fewer tools sit next to the key, the less there is to trust. Same pinned base as the
# kernel builder; toolchain.packages installed by sha256 from toolchain.lock with every
# repository disabled (../lock.sh). Build context: forge/specs/azoth.
FROM registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b

RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

COPY lock.sh /usr/local/share/azoth/
COPY sign/toolchain.lock /usr/local/share/azoth/toolchain.lock
RUN bash /usr/local/share/azoth/lock.sh install /usr/local/share/azoth/toolchain.lock
