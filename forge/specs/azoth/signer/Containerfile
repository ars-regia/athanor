# Athanor OS: environment of the kernel signatures (forge/specs/azoth/sign-kernel.sh;
# docs/architecture/doc_ci.md, D43). The sign-only job of nvidia-kmod.yml runs this image by
# the digest in signer/image.digest and never builds it: next to the Secure Boot and module
# keys run only Fedora's sbsigntools, openssl, kmod (modinfo) and the sign-file of Fedora's
# kernel-devel, never a binary this project compiled. The packages are toolchain.packages,
# installed by sha256 from toolchain.lock with every repository disabled (../lock.sh).
# Build context: forge/specs/azoth. Published by .github/workflows/azoth-signer.yml.
FROM registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b

RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

COPY lock.sh /usr/local/share/azoth/
COPY signer/toolchain.lock /usr/local/share/azoth/toolchain.lock
RUN bash /usr/local/share/azoth/lock.sh install /usr/local/share/azoth/toolchain.lock
