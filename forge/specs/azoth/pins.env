# Pins of the Athanor kernel. Read by build.sh, updated by the bump bot (phase K5).
# Every file these pins identify has its own hash in SOURCES/sources.sha256.
# See docs/architecture/doc_kernel_build.md, section 2.

# Fedora SRPM from koji: the stable build with the same patch level as CACHYOS_RELEASE,
# because the base diff only applies to the tree it was computed from.
FEDORA_KERNEL_NVR=7.2.8-100.fc43
# Fingerprint of the release signing key, the same one the base image ships in
# /etc/pki/rpm-gpg: the last 8 hex digits are the koji sigcache directory.
FEDORA_KEY_FPR=c6e7f081cf80e13146676e88829b606631645531

# stable follows the latest series that both Fedora and CachyOS ship; lts the 6.18 one.
KERNEL_CHANNEL=stable

# CachyOS tree (signed GitHub release) of the same series: the Athanor base is the diff
# between the vanilla tarball of that patch level and this tarball.
CACHYOS_RELEASE=cachyos-7.2.8-1

# Commit of CachyOS/linux-cachyos that linux-cachyos/config comes from: the Kconfig
# options introduced by the base take the values of that config.
CACHYOS_CONFIG_COMMIT=6676e72b85eb9e30d079a8c3dcdf93aedd1e8226

# Commit of CachyOS/kernel-patches that the patches of patches.list come from.
CACHYOS_PATCHES_COMMIT=17bb0bb818d283d0dc6e0280a2e9d5b95e66808b

# NVIDIA kernel modules (section 10, phase K4), outside the kernel inputs: they do not
# change the kernel RPMs and do not invalidate the reuse (build-inputs.py excludes them).
# open: GitHub NVIDIA/open-gpu-kernel-modules, the tag is annotated and may move, the
# commit may not: nvidia.sh verifies the commit. legacy: the proprietary .run of the 580
# branch (Maxwell, Pascal, Volta), pinned by sha256 in nvidia/sources.sha256, not in the
# kernel manifest, which build.sh verifies in full and whose hash is a reuse input.
NVIDIA_OPEN_VERSION=615.71.09
NVIDIA_OPEN_COMMIT=61dcc93722ecb418bb5f2e00923f05b4b8051dd1
NVIDIA_LEGACY_VERSION=580.178.04
