# Athanor OS: environment of the kernel boot matrix (docs/architecture/doc_kernel_build.md,
# section 7, gate 3). Same pinned base as the builder, but nothing is compiled here:
# boot.sh extracts vmlinuz from the kernel-core, builds a test initramfs and a UKI signed
# with an ephemeral MOK, enrols the MOK in the OVMF varstore and boots QEMU.
# microvm/boot.sh (section 9) boots the guest kernel in Firecracker with an ext4 rootfs;
# bench.sh (section 7, gate 5) measures the kernel in QEMU with hackbench, schbench, fio, netperf.

# schbench is not in the Fedora repos: from source at the pinned commit, in a separate
# stage so that gcc stays out of the image.
FROM registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b AS schbench
ARG SCHBENCH_COMMIT=24e32b8ef67cbafb0761aed68747d90a291767ae
RUN dnf -y install gcc make tar \
    && curl -fsSL "https://github.com/masoncl/schbench/archive/${SCHBENCH_COMMIT}.tar.gz" | tar -xz -C /tmp --no-same-owner \
    && make -C "/tmp/schbench-${SCHBENCH_COMMIT}" \
    && install -m 755 "/tmp/schbench-${SCHBENCH_COMMIT}/schbench" /usr/local/bin/schbench

FROM registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b

RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

# qemu with KVM or TCG and SeaBIOS; OVMF with Secure Boot; the Microsoft-signed Fedora
# shim; ukify and the systemd stub for the UKI, sbsign to sign it; virt-firmware to write
# the MOK into the varstore; busybox (static) and bpftool for the test initramfs;
# e2fsprogs for the ext4 rootfs of the guest kernel; realtime-tests (hackbench), fio and
# netperf for the benchmark.
RUN dnf -y install \
      qemu-system-x86-core edk2-ovmf shim-x64 \
      systemd-ukify systemd-boot-unsigned sbsigntools python3-virt-firmware \
      busybox bpftool cpio zstd openssl e2fsprogs realtime-tests fio netperf \
    && dnf clean all
COPY --from=schbench /usr/local/bin/schbench /usr/local/bin/schbench

# Firecracker is not in the Fedora repos: the GitHub release, pinned by hash.
ARG FIRECRACKER=v1.16.1
ARG FIRECRACKER_SHA256=382a02a869e4d6d5cb14c40577f9545e8458021ea8b0b2d3fc10ec14d9c242e6
RUN curl -fsSL -o /tmp/firecracker.tgz "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER}/firecracker-${FIRECRACKER}-x86_64.tgz" \
    && echo "${FIRECRACKER_SHA256}  /tmp/firecracker.tgz" | sha256sum --check --quiet \
    && tar -xzf /tmp/firecracker.tgz -C /tmp --no-same-owner "release-${FIRECRACKER}-x86_64/firecracker-${FIRECRACKER}-x86_64" \
    && install -m 755 "/tmp/release-${FIRECRACKER}-x86_64/firecracker-${FIRECRACKER}-x86_64" /usr/local/bin/firecracker \
    && rm -r /tmp/firecracker.tgz "/tmp/release-${FIRECRACKER}-x86_64"
