#!/bin/sh
# PID 1 of the test initramfs of the boot matrix (docs/architecture/doc_kernel_build.md,
# section 7, gate 3). No rootfs: mounts the pseudo file systems, checks the assertions,
# writes to the serial console a `K3 RESULT ok|fail` verdict that boot.sh reads, and
# powers the virtual machine off. boot.sh puts the k3.* parameters in the test command line.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t devtmpfs devtmpfs /dev
exec > /dev/console 2>&1 < /dev/console
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t securityfs securityfs /sys/kernel/security
mount -t cgroup2 cgroup2 /sys/fs/cgroup
[ -d /sys/firmware/efi/efivars ] && mount -t efivarfs efivarfs /sys/firmware/efi/efivars

uname_expected='' sb='' insmod_list='' certs_list='' iommu='' builtin_expected='' imakey=''
# shellcheck disable=SC2013 # words of the command line, not lines
for w in $(cat /proc/cmdline); do
  case $w in
    k3.uname=*) uname_expected=${w#*=} ;;
    k3.sb=1) sb=1 ;;
    k3.insmod=*) insmod_list=${w#*=} ;;
    k3.certs=*) certs_list=${w#*=} ;;
    k3.iommu=*) iommu=${w#*=} ;;
    k3.builtin=*) builtin_expected=${w#*=} ;;
    k3.imakey=1) imakey=1 ;;
    k3.mokca=*) mokca_list=${w#*=} ;;
  esac
done

imakey_file=${K3_IMAKEY:-/ima/key.der}
fail=''
check() { # check NAME COMMAND...
  name=$1; shift
  if "$@" > /tmp/check.out 2>&1; then
    echo "K3 ok   $name"
  else
    echo "K3 FAIL $name"; fail="$fail $name"
  fi
  sed 's/^/        /' /tmp/check.out
}
secureboot() { # the SecureBoot efivar: 4 bytes of attributes, then the value (01 = on).
  # Read in full: efivarfs does not support seek.
  v=$(hexdump -v -e '1/1 "%02x "' /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c | awk '{print $5}')
  echo "SecureBoot=$v"; [ "$v" = 01 ]
}
bbr() { # the default must be CachyOS's BBR v3, which registers as "bbr3"
  v=$(cat /proc/sys/net/ipv4/tcp_congestion_control)
  echo "current: $v; available: $(cat /proc/sys/net/ipv4/tcp_available_congestion_control)"; [ "$v" = bbr3 ]
}
# The files the checks below read: variables so that tests/test_boot_init.py can point them elsewhere.
lsm_list=${K3_LSM_LIST:-/sys/kernel/security/lsm}
cgroup_controllers=${K3_CGROUP_CONTROLLERS:-/sys/fs/cgroup/cgroup.controllers}
vm_dir=${K3_VM_DIR:-/proc/sys/vm}
iommu_groups=${K3_IOMMU_GROUPS:-/sys/kernel/iommu_groups}
kernel_config=${K3_CONFIG:-/proc/config.gz}
cmdline_file=${K3_CMDLINE:-/proc/cmdline}
lockdown_file=${K3_LOCKDOWN:-/sys/kernel/security/lockdown}
maps_file=${K3_MAPS:-/proc/self/maps}
debugfs_dir=${K3_DEBUGFS_DIR:-/tmp/debugfs}
not_on_cmdline() { # not_on_cmdline NAME: the build, not the command line, sets NAME
  if tr ' ' '\n' < "$cmdline_file" | grep -q "^$1="; then echo "$1= is on the command line"; return 1; fi
}
lockdown_forced() { # LOCK_DOWN_KERNEL_FORCE_INTEGRITY, with no lockdown= to lean on
  echo "lockdown: $(cat "$lockdown_file")"
  not_on_cmdline lockdown && grep -q '\[integrity\]' "$lockdown_file"
}
init_on_free_built_in() { # INIT_ON_FREE_DEFAULT_ON
  dmesg | grep 'mem auto-init:'; not_on_cmdline init_on_free && dmesg | grep -q 'heap free:on'
}
vsyscall_none() { # LEGACY_VSYSCALL_NONE: no vsyscall page in any process
  not_on_cmdline vsyscall && ! grep -q '\[vsyscall\]' "$maps_file"
}
debugfs_off() { # DEBUG_FS_ALLOW_NONE: debugfs never registers, so it cannot be mounted
  not_on_cmdline debugfs && kconfig_enabled DEBUG_FS_ALLOW_NONE || return 1
  mkdir -p "$debugfs_dir"
  if mount -t debugfs debugfs "$debugfs_dir"; then echo "debugfs mounted"; return 1; fi
}
preempt_lazy() { # D13: debugfs is off, so the mode is read from the boot log
  line=$(dmesg | grep -o 'Dynamic Preempt: [a-z]*')
  echo "${line:-no Dynamic Preempt line}"; [ "$line" = "Dynamic Preempt: lazy" ]
}
aslr_bits() { # section 5: ARCH_MMAP_RND_BITS=32, ARCH_MMAP_RND_COMPAT_BITS=16
  b=$(cat "$vm_dir/mmap_rnd_bits") c=$(cat "$vm_dir/mmap_rnd_compat_bits")
  echo "mmap_rnd_bits=$b mmap_rnd_compat_bits=$c"; [ "$b" = 32 ] && [ "$c" = 16 ]
}
iommu_domains() { # D16: lazy domains (DMA-FQ); an IOMMU case with no group is a failure
  # A virtual IOMMU that caches non-present entries makes the kernel force strict mode
  # (AMD-Vi "Using strict mode due to virtualization", VT-d "IOMMU batching disallowed due
  # to virtualization"): the domains are then DMA, still translated, never identity. The
  # build must still default to lazy, so that this exception cannot hide a strict kernel.
  kconfig_enabled IOMMU_DEFAULT_DMA_LAZY || return 1
  want=DMA-FQ
  dmesg | grep -qE 'strict mode due to virtualization|batching disallowed due to virtualization' && want=DMA
  n=0 bad=0
  for t in "$iommu_groups"/*/type; do
    [ -f "$t" ] || continue
    n=$((n + 1)); v=$(cat "$t"); echo "${t%/type}: $v"; [ "$v" = "$want" ] || bad=1
  done
  echo "groups: $n, expected type $want"
  [ "$n" -gt 0 ] && [ "$bad" = 0 ]
}
kconfig_enabled() { # kconfig_enabled NAME...: each CONFIG_NAME is y or m
  missing=''
  for o in "$@"; do zcat "$kernel_config" | grep -qE "^CONFIG_$o=(y|m)$" || missing="$missing $o"; done
  echo "missing:${missing:- none}"; [ -z "$missing" ]
}
landlock() { # compiled in is not enough: it must be in the active LSM list, as no lsm= is given
  echo "lsm: $(cat "$lsm_list")"
  tr ',' '\n' < "$lsm_list" | grep -qx landlock
}
memcg() { # the memory controller is what MemoryMax= and the memory budgets are made of
  echo "controllers: $(cat "$cgroup_controllers")"
  tr ' ' '\n' < "$cgroup_controllers" | grep -qx memory
}
ima() { # securityfs files always have size 0: look at the content
  grep -q . /sys/kernel/security/ima/ascii_runtime_measurements
}
insmod_expect() { # insmod_expect FILE ERRNO: insmod must end with the expected errno (or 0)
  case $2 in
    0) want='' ;;
    ENODEV) want='No such device' ;;
    EKEYREJECTED) want='Key was rejected by service' ;;
    *) echo "unknown errno: $2"; return 1 ;;
  esac
  out=$(insmod "/modules/$1" 2>&1); rc=$?
  echo "insmod $1: rc=$rc ${out:+($out)}; expected $2"
  if [ "$want" ]; then [ $rc -ne 0 ] && echo "$out" | grep -qF "$want"; else [ $rc -eq 0 ]; fi
}
ima_key_refused() { # D40, D46: a key vouched only by a machine-keyring CA never enters .ima
  keyctl describe %:.ima || { echo "no .ima keyring"; return 1; }
  [ -s "$imakey_file" ] || { echo "no key to offer: $imakey_file"; return 1; }
  out=$(keyctl padd asymmetric '' %:.ima < "$imakey_file" 2>&1) && { echo "the key was accepted"; return 1; }
  case $out in
    # ENOKEY: restrict_link_by_signature() found no signer in the keyring .ima trusts, the
    # builtin one; EKEYREJECTED would mean a signer was found and the signature failed.
    *'Required key not available'*) ;;
    *) echo "refused for another reason: $out"; return 1 ;;
  esac
  keyctl list %:.ima
}
machine_ca() { # machine_ca SKID: D40, the kernel trusted this user CA for the machine keyring
  # A MOK the kernel does not trust lands in .platform, which never verifies modules.
  keys=$(keyctl list %:.machine) || { echo "cannot read .machine"; return 1; }
  echo "$keys"
  echo "$keys" | grep -qE "asymmetric: .*: $1\$"
}
builtin_exact() { # D40: the builtin keyring holds exactly the expected keys
  keyctl list %:.builtin_trusted_keys
  ids=$(keyctl rlist %:.builtin_trusted_keys) || { echo "cannot read .builtin_trusted_keys"; return 1; }
  n=$(echo "$ids" | wc -w)
  echo "builtin keys: $n, expected ${builtin_expected:-nothing}"
  [ -n "$builtin_expected" ] && [ "$n" = "$builtin_expected" ]
}
cert_loaded() { # cert_loaded SKID: the kernel loaded a compiled-in certificate with this key
  # id; x509_load_certificate_list logs "Loaded X.509 cert '<CN>: <skid in hex>'" for the
  # trusted keyring and the revocation list alike.
  dmesg | grep -E "Loaded X.509 cert '.*: $1'"
}

echo "K3 uname: $(uname -a)"
echo "K3 cmdline: $(cat /proc/cmdline)"
check uname       test "$(uname -r)" = "$uname_expected"
check btf         test -s /sys/kernel/btf/vmlinux
check bpftool     sh -c 'bpftool feature probe kernel | grep -q "^bpf() syscall is available"'
check sched_ext   test -d /sys/kernel/sched_ext
check ima         ima
check lockdown    lockdown_forced
check init-on-free init_on_free_built_in
check vsyscall    vsyscall_none
check debugfs     debugfs_off
check bbr         bbr
check landlock    landlock
check memcg       memcg
check preempt     preempt_lazy
check aslr        aslr_bits
# The mesh platform requirements of section 7, enabled in the kernel today.
check mesh-platform kconfig_enabled WIREGUARD KVM_INTEL KVM_AMD VHOST_VSOCK VIRTIO_FS DRM_VIRTIO_GPU UDMABUF VFIO_PCI TCG_TPM
[ "$iommu" ] && check iommu iommu_domains
check taint       test "$(cat /proc/sys/kernel/tainted)" = 0
# Only the splat signatures: the hw-vuln warnings (e.g. SRSO on AMD in a VM) contain
# "WARNING:" but are not kernel errors; a real WARN reads "WARNING: CPU: N PID: ...".
check dmesg       sh -c '! dmesg | grep -E "BUG: |kernel BUG at|WARNING: CPU: |Oops: |Call Trace:|cut here"'
for skid in $(echo "$certs_list" | tr ',' ' '); do
  check "cert-$skid" cert_loaded "$skid"
done
check builtin-set builtin_exact
if [ "$sb" ]; then
  check secureboot secureboot
  check moklist    test -e /sys/firmware/efi/efivars/MokListRT-605dab50-e046-4300-abb6-3dd810dd8b23
  for skid in $(echo "$mokca_list" | tr ',' ' '); do
    check "machine-ca-$skid" machine_ca "$skid"
  done
fi
[ "$imakey" ] && check ima-key ima_key_refused
# Last: an external module taints the kernel (taint O, P) even when its init fails, and
# the assertions above must see it clean.
for item in $(echo "$insmod_list" | tr ',' ' '); do
  check "insmod-${item%%:*}" insmod_expect "${item%%:*}" "${item##*:}"
done

echo "K3 dmesg begin"; dmesg; echo "K3 dmesg end"
if [ -z "$fail" ]; then echo "K3 RESULT ok"; else echo "K3 RESULT fail:$fail"; fi
sync
# Powers the VM off: QEMU exits. If the ACPI call does not get through, sysrq `o` forces it.
poweroff -f
sleep 5
echo o > /proc/sysrq-trigger
