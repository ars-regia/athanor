# The options the tree introduces, with the values of the CachyOS config (doc_kernel_build.md,
# section 8). Rewritten by build.sh --stage refresh; every line is reviewed before it is committed.
# CONFIG_MZEN4 is not set
# CONFIG_HZ_600 is not set
# CONFIG_HZ_750 is not set
CONFIG_MIN_BASE_SLICE_NS=1600000
CONFIG_CFI_AUTO_DEFAULT=y
CONFIG_MQ_IOSCHED_ADIOS=y
# CONFIG_DEFAULT_CODEL is not set
# CONFIG_DEFAULT_FQ_PIE is not set
# CONFIG_DEFAULT_SFQ is not set
# CONFIG_DEFAULT_PFIFO_FAST is not set
CONFIG_VHBA=m
CONFIG_MFD_MACSMC_CORE=m
CONFIG_V4L2_LOOPBACK=m
# CONFIG_AMD_PRIVATE_COLOR is not set
CONFIG_SND_HDA_SCODEC_MAX98390_I2C=m
CONFIG_T2BCE_CORE=m
CONFIG_KSTACK_ERASE_TRACK_MIN_SIZE=100
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set
# CONFIG_TEST_DEBUG_VIRTUAL is not set
# CONFIG_MQ_IOSCHED_DEFAULT_ADIOS is not set
CONFIG_SENSORS_MACSMC_HWMON=m
CONFIG_RTC_DRV_MACSMC=m
CONFIG_T2BCE_VHCI=m
CONFIG_T2BCE_AUDIO=m
CONFIG_T2BCE_AVE=m
CONFIG_MACSMC_ACPI=m
CONFIG_MACSMC_WDT=m
CONFIG_LEDS_MACSMC=m
CONFIG_MACSMC_ACCEL=m
CONFIG_MACSMC_LIGHT=m
