# Athanor OS: environment of the NVIDIA kernel modules (docs/architecture/doc_kernel_build.md,
# section 10, phase K4). Same pinned base as the kernel builder, but only what nvidia.sh
# needs: the LLVM toolchain the kernel is compiled with (kCFI), Kbuild from the
# kernel-devel tree extracted from the RPM, kmod for modinfo. It does not sign: the signer
# image does (signer/Containerfile). No rust, pahole or koji: a smaller and faster image
# than the builder, and it does not touch the builder's Containerfile (which is an input of the kernel reuse).
# The packages are toolchain.packages, installed by sha256 from toolchain.lock with every
# repository disabled (../lock.sh). Build context: forge/specs/azoth.
FROM registry.fedoraproject.org/fedora:43@sha256:08bba635be5e58af81ae39d88fda4a311bcfe0d8b4b7e98e28c109f16c391d9b

RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

COPY lock.sh /usr/local/share/azoth/
COPY nvidia/toolchain.lock /usr/local/share/azoth/toolchain.lock
RUN bash /usr/local/share/azoth/lock.sh install /usr/local/share/azoth/toolchain.lock
