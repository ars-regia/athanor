# Athanor OS Kconfig delta on top of the Fedora x86_64 config. kernel.spec merges it with
# merge.py as partial-kernel-local-snip.config (Source3001); build.sh verifies every line
# of it against the generated config. The options that the CachyOS tree introduces do
# not live here: build.sh appends them with the values of the pinned CachyOS config.
# See docs/architecture/doc_kernel_build.md, section 4.

# Scheduler: BORE on top of EEVDF and the CachyOS tunables.
CONFIG_SCHED_BORE=y
CONFIG_CACHY=y

# Codegen: -O2, no LTO. -O3 (the CachyOS default) was measured with the weekly A/B
# (variants/o3): never better than the noise, -O2 wins hackbench (decision of
# 2026-09-05, section 13 of the specification). Fedora's clang_lto fragment turns
# ThinLTO on, but Rust with DEBUG_INFO_BTF requires !LTO: it comes back when pahole
# copes with the DWARF merged by LTO (decision of 2026-09-04, section 13).
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3 is not set
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set

# ISA: baseline x86-64, every PC from 2014/2015 onwards (CachyOS more-uarches patch).
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=1

# Rust on as in Fedora: it is the door to the drivers that will be born in Rust. In 7.1
# RUST depends on !RANDSTRUCT and, with DEBUG_INFO_BTF, on !LTO. With kCFI it selects
# CFI_ICALL_NORMALIZE_INTEGERS.
CONFIG_RUST=y
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y

# Hardening beyond Fedora.
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set
CONFIG_ZERO_CALL_USED_REGS=y
# RANDSTRUCT stays NONE as in Fedora: RUST depends on !RANDSTRUCT.
CONFIG_RANDSTRUCT_NONE=y
# CONFIG_RANDSTRUCT_FULL is not set
CONFIG_MODULE_SIG_FORCE=y
# External modules (NVIDIA) are trusted through the project module signing certificate
# compiled into the kernel, whatever the firmware state; retired project keys are
# revoked. build.sh places both files in the tree from keys/modules and keys/revoked.
CONFIG_SYSTEM_TRUSTED_KEYS="certs/athanor-modules.pem"
CONFIG_SYSTEM_REVOCATION_LIST=y
CONFIG_SYSTEM_REVOCATION_KEYS="certs/athanor-revoked.pem"

# Network: BBRv3 (TCP_CONG_BBR3 symbol of the CachyOS base) and FQ by default.
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_FQ_CODEL is not set

# Memory: zstd for zswap and zram (the zswap default selects CRYPTO_ZSTD built-in).
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
# CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZO is not set
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set

# Slab hardening: partitioned kmalloc caches in the random mode, the protection of
# RANDOM_KMALLOC_CACHES in 7.1. Fedora selects the type-based mode (KMALLOC_PARTITION_TYPED),
# which needs the compiler's allocation tokens (-falloc-token-max): the clang of Fedora 43
# has none, so the choice would fall back to random and fail Fedora's config gate. build.sh
# stops once the compiler supports allocation tokens: remove these three lines then, Fedora's
# type-based mode applies on its own (decision of 2026-09-14, section 13 of the specification).
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
# CONFIG_KMALLOC_PARTITION_TYPED is not set

# Immutable rootfs: EROFS in the kernel, config readable from /proc.
CONFIG_EROFS_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
