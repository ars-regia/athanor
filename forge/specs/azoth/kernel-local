# Athanor OS Kconfig delta on top of the Fedora x86_64 config. kernel.spec merges it with
# merge.py as partial-kernel-local-snip.config (Source3001); build.sh verifies every line
# of it against the generated config. The options that the CachyOS tree introduces do
# not live here: build.sh appends them with the values of the pinned CachyOS config.
# See docs/architecture/doc_kernel_build.md, section 4.

# Scheduler: BORE on top of EEVDF and the CachyOS tunables.
CONFIG_SCHED_BORE=y
CONFIG_CACHY=y

# Codegen: -O2, no LTO. -O3 (the CachyOS default) was measured with the weekly A/B
# (variants/o3): never better than the noise, -O2 wins hackbench (decision of
# 2026-09-05, section 13 of the specification). Fedora's clang_lto fragment turns
# ThinLTO on, but Rust with DEBUG_INFO_BTF requires !LTO: it comes back when pahole
# copes with the DWARF merged by LTO (decision of 2026-09-04, section 13).
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3 is not set
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set

# ISA: baseline x86-64, every PC from 2014/2015 onwards (CachyOS more-uarches patch).
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=1

# Rust on as in Fedora: it is the door to the drivers that will be born in Rust. In 7.1
# RUST depends on !RANDSTRUCT and, with DEBUG_INFO_BTF, on !LTO. With kCFI it selects
# CFI_ICALL_NORMALIZE_INTEGERS.
CONFIG_RUST=y
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y

# Hardening beyond Fedora.
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set
CONFIG_ZERO_CALL_USED_REGS=y
# RANDSTRUCT stays NONE as in Fedora: RUST depends on !RANDSTRUCT.
CONFIG_RANDSTRUCT_NONE=y
# CONFIG_RANDSTRUCT_FULL is not set
CONFIG_MODULE_SIG_FORCE=y
# External modules (NVIDIA) are trusted through the project module signing certificate
# compiled into the kernel, whatever the firmware state; retired project keys are
# revoked. build.sh places both files in the tree from keys/modules and keys/revoked.
CONFIG_SYSTEM_TRUSTED_KEYS="certs/athanor-modules.pem"
CONFIG_SYSTEM_REVOCATION_LIST=y
CONFIG_SYSTEM_REVOCATION_KEYS="certs/athanor-revoked.pem"

# Network: BBRv3 (TCP_CONG_BBR3 symbol of the CachyOS base) and FQ by default.
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_FQ_CODEL is not set

# Memory: zstd for zswap and zram (the zswap default selects CRYPTO_ZSTD built-in).
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
# CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZO is not set
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set

# Slab hardening: partitioned kmalloc caches in the random mode, the protection of
# RANDOM_KMALLOC_CACHES in 7.1. Fedora selects the type-based mode (KMALLOC_PARTITION_TYPED),
# which needs the compiler's allocation tokens (-falloc-token-max): the clang of Fedora 43
# has none, so the choice would fall back to random and fail Fedora's config gate. build.sh
# stops once the compiler supports allocation tokens: remove these three lines then, Fedora's
# type-based mode applies on its own (decision of 2026-09-14, section 13 of the specification).
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
# CONFIG_KMALLOC_PARTITION_TYPED is not set

# Immutable rootfs: EROFS in the kernel, config readable from /proc.
CONFIG_EROFS_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# What Fedora already sets and Athanor depends on, said here so that build.sh (check_delta)
# stops the build if a Fedora bump drops one, instead of a kernel that boots without it.
# Landlock is how applications confine themselves (athanor-sandbox, doc_kernel_profile.md,
# section 9); the memory controller is what MemoryMax= and the memory budget of the local
# inference are made of. That Landlock is also in the active LSM list, and the controller
# available, is checked at boot (boot/init).
CONFIG_SECURITY_LANDLOCK=y
CONFIG_MEMCG=y

# Kernel profile, block P2 (docs/architecture/doc_kernel_profile.md, section 5). Every option
# between the markers is also a locked [base.kconfig] entry of
# forge/specs/athanor-kernel-profile/profile.toml, so athanor-profile-check verifies it on the
# machine; tests/test_kernel_profile.py keeps the two equal. Items marked P4b, P5 or P6 in
# section 5 are not here.
# BEGIN kernel profile P2
# From the command line into the build (section 6 drops lockdown, init_on_free, vsyscall
# and debugfs from [base.cmdline]). Forced lockdown is registered early and cannot be
# lowered at boot. The debugfs choice of the 7.2 tree (lib/Kconfig.debug) has two arms,
# ALLOW_ALL and ALLOW_NONE, and no DEBUG_FS_DISALLOW_MOUNT: the arms are exclusive, and
# ALLOW_NONE, which refuses both the API and the mount, is the single choice.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE is not set
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
CONFIG_DEBUG_FS_ALLOW_NONE=y
# CONFIG_DEBUG_FS_ALLOW_ALL is not set
# D16: lazy IOMMU domains by default; section 5 rejects IOMMU_DEFAULT_DMA_STRICT.
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# CONFIG_IOMMU_DEFAULT_DMA_STRICT is not set
# Reliability (D19, section 11): crash evidence through EFI pstore.
CONFIG_PANIC_TIMEOUT=10
CONFIG_EFI_VARS_PSTORE=y
# CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE is not set
# New hardening.
CONFIG_KSTACK_ERASE=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_DEBUG_VIRTUAL=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
CONFIG_PROC_MEM_FORCE_PTRACE=y
# CONFIG_PROC_MEM_ALWAYS_FORCE is not set
# CONFIG_PROC_MEM_NO_FORCE is not set
CONFIG_SECONDARY_TRUSTED_KEYRING=y
CONFIG_SECONDARY_TRUSTED_KEYRING_SIGNED_BY_BUILTIN=y
# Applied unless the boot matrix fails; withdrawn only through a recorded decision. MSEAL
# needs CHECKPOINT_RESTORE off (no CRIU, gVisor, rr, UML); Mesa and systemd use kcmp().
CONFIG_UBSAN_TRAP=y
# CONFIG_PROC_KCORE is not set
# CONFIG_BLK_DEV_WRITE_MOUNTED is not set
# CONFIG_CHECKPOINT_RESTORE is not set
CONFIG_KCMP=y
CONFIG_MSEAL_SYSTEM_MAPPINGS=y
# Keyrings (D40, D46): root hashes and IPE policies verify against the builtin keyring only;
# the user path of D40 goes through the machine keyring.
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
# CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_SECONDARY_KEYRING is not set
# CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_PLATFORM_KEYRING is not set
CONFIG_SECURITY_IPE=y
# CONFIG_IPE_POLICY_SIG_SECONDARY_KEYRING is not set
# CONFIG_IPE_POLICY_SIG_PLATFORM_KEYRING is not set
# CONFIG_IMA_KEYRINGS_PERMIT_SIGNED_BY_BUILTIN_OR_SECONDARY is not set
CONFIG_INTEGRITY_MACHINE_KEYRING=y
CONFIG_INTEGRITY_CA_MACHINE_KEYRING=y
CONFIG_INTEGRITY_CA_MACHINE_KEYRING_MAX=y
# Attack surface removed (unused by every role).
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_LIVEPATCH is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_X86_IOPL_IOPERM is not set
CONFIG_LSM="lockdown,yama,selinux,bpf,landlock,ipe"
# Codegen (D13): preemption lazy, dynamic; AutoFDO profiles arrive in P7.
CONFIG_AUTOFDO_CLANG=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set
# Built-in drivers of D17, kept on purpose; I2C_DESIGNWARE_CORE because the platform driver
# needs it.
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_USB_HID=y
CONFIG_SERIO_I8042=y
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_BTRFS_FS=y
# END kernel profile P2
