From: athanor <kernel@athanor.os>
Subject: [PATCH] x86/ibt: poison only real kCFI preambles when sealing a module

apply_seal_endbr() clobbers the ENDBR of every function objtool found
never to be called indirectly and, with CONFIG_FINEIBT, also calls
poison_cfi() on the CFI_OFFSET bytes before it. In kCFI mode, the mode
cfi=auto selects on a CPU without IBT, poison_cfi() checks only that
the first byte is a movl $imm32 opcode (0xb8..0xbf) and then zeroes the
four bytes after it.

Code built by Kbuild always has its preamble there. A module can also
link objects that were not built with kCFI, such as the prebuilt RM
core of the proprietary NVIDIA driver (nv-kernel.o_binary): their
functions have no preamble, and the bytes before their ENDBR are the
tail of the previous function. Whenever one of those bytes happens to
be 0xb8..0xbf, the kernel rewrites live code: the immediate of a
movl $imm32, or a relocated address, becomes zero. On an AMD Zen host
the 580.178.04 legacy module has 14146 sealed ENDBRs, 507 of them with
a real preamble and 485 more where the byte matches by chance; one of
them sits on the rm_init_rm() path and the load ends in a page fault in
_nv005762rm. With cfi=off, or with FineIBT, which checks for its own
ENDBR first, the module loads.

Make the module path exact: collect the preambles listed in the
module's .cfi_sites, sort them, and poison only a sealed function whose
preamble is among them. vmlinux keeps the current behaviour, since every
function it seals comes from Kbuild. A module that cannot get the
memory for the table fails to load instead of being sealed blindly.
UML, which builds this module.c without alternative.c, gets a stub
next to its other ones.
---
--- a/arch/x86/include/asm/alternative.h
+++ b/arch/x86/include/asm/alternative.h
@@ -100,6 +100,8 @@
 extern void apply_retpolines(s32 *start, s32 *end);
 extern void apply_returns(s32 *start, s32 *end);
 extern void apply_seal_endbr(s32 *start, s32 *end);
+extern int apply_seal_endbr_module(s32 *start, s32 *end,
+				   s32 *start_cfi, s32 *end_cfi);
 extern void apply_fineibt(s32 *start_retpoline, s32 *end_retpoine,
 			  s32 *start_cfi, s32 *end_cfi);
 
--- a/arch/x86/kernel/alternative.c
+++ b/arch/x86/kernel/alternative.c
@@ -9,6 +9,9 @@
 #include <linux/cleanup.h>
 #include <linux/kgdb.h>
 #include <linux/mmap_lock.h>
+#include <linux/bsearch.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
 
 #include <asm/text-patching.h>
 #include <asm/insn.h>
@@ -1170,28 +1173,78 @@
 	text_poke_early(addr, &poison, 4);
 }
 
+static int __init_or_module cmp_cfi_site(const void *a, const void *b)
+{
+	return cmp_int(*(const unsigned long *)a, *(const unsigned long *)b);
+}
+
 /*
- * Generated by: objtool --ibt
- *
- * Seal the functions for indirect calls by clobbering the ENDBR instructions
- * and the kCFI hash value.
+ * Seal the functions of [start, end) and, when @cfi is not NULL, poison the
+ * kCFI hash only of the functions whose preamble @cfi lists (sorted, @ncfi
+ * entries); with @cfi NULL every sealed function has a preamble.
  */
-void __init_or_module noinline apply_seal_endbr(s32 *start, s32 *end)
+static void __init_or_module seal_endbr(s32 *start, s32 *end,
+					const unsigned long *cfi, size_t ncfi)
 {
 	s32 *s;
 
 	for (s = start; s < end; s++) {
 		void *addr = (void *)s + *s;
+		unsigned long preamble = (unsigned long)addr - CFI_OFFSET;
 
 		poison_endbr(addr);
-		if (IS_ENABLED(CONFIG_FINEIBT))
-			poison_cfi(addr - CFI_OFFSET);
+		if (!IS_ENABLED(CONFIG_FINEIBT))
+			continue;
+		if (cfi && !bsearch(&preamble, cfi, ncfi, sizeof(*cfi), cmp_cfi_site))
+			continue;
+		poison_cfi((void *)preamble);
 	}
 }
 
+/*
+ * Generated by: objtool --ibt
+ *
+ * Seal the functions for indirect calls by clobbering the ENDBR instructions
+ * and the kCFI hash value. vmlinux is built by Kbuild only, so every function
+ * it seals has a kCFI preamble.
+ */
+void __init_or_module noinline apply_seal_endbr(s32 *start, s32 *end)
+{
+	seal_endbr(start, end, NULL, 0);
+}
+
+/*
+ * A module can link objects that were not built with kCFI, such as a prebuilt
+ * vendor blob. Their functions have no preamble: the CFI_OFFSET bytes before
+ * their ENDBR belong to the previous function, and in kCFI mode poison_cfi()
+ * would zero the immediate of any movl $imm32 that starts there. Poison the
+ * hash only of the functions listed in the module's .cfi_sites.
+ */
+int __init_or_module apply_seal_endbr_module(s32 *start, s32 *end,
+					     s32 *start_cfi, s32 *end_cfi)
+{
+	size_t i, ncfi = end_cfi - start_cfi;
+	unsigned long *cfi;
+
+	cfi = kvmalloc_array(ncfi, sizeof(*cfi), GFP_KERNEL);
+	if (!cfi)
+		return -ENOMEM;
+	for (i = 0; i < ncfi; i++)
+		cfi[i] = (unsigned long)&start_cfi[i] + start_cfi[i];
+	sort(cfi, ncfi, sizeof(*cfi), cmp_cfi_site, NULL);
+	seal_endbr(start, end, cfi, ncfi);
+	kvfree(cfi);
+	return 0;
+}
+
 #else /* !CONFIG_X86_KERNEL_IBT: */
 
 void __init_or_module apply_seal_endbr(s32 *start, s32 *end) { }
+int __init_or_module apply_seal_endbr_module(s32 *start, s32 *end,
+					     s32 *start_cfi, s32 *end_cfi)
+{
+	return 0;
+}
 
 #endif /* !CONFIG_X86_KERNEL_IBT */
 
--- a/arch/x86/kernel/module.c
+++ b/arch/x86/kernel/module.c
@@ -298,7 +298,14 @@
 	}
 	if (ibt_endbr) {
 		void *iseg = (void *)ibt_endbr->sh_addr;
-		apply_seal_endbr(iseg, iseg + ibt_endbr->sh_size);
+		void *cseg = cfi ? (void *)cfi->sh_addr : NULL;
+		unsigned int csize = cfi ? cfi->sh_size : 0;
+		int ret;
+
+		ret = apply_seal_endbr_module(iseg, iseg + ibt_endbr->sh_size,
+					      cseg, cseg + csize);
+		if (ret)
+			return ret;
 	}
 	if (locks) {
 		void *lseg = (void *)locks->sh_addr;
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -434,6 +434,11 @@
 {
 }
 
+int apply_seal_endbr_module(s32 *start, s32 *end, s32 *start_cfi, s32 *end_cfi)
+{
+	return 0;
+}
+
 void apply_retpolines(s32 *start, s32 *end)
 {
 }
