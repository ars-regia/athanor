#!/bin/sh
# PID 1 of the benchmark initramfs (bench.sh): the tests in sequence, each prints one
# `K7 <metric> <value> <unit>` line on the serial console, then `K7 RESULT ok` and reboot.
# Duration of each test from k7.seconds on the command line (default 30).
mount -t proc proc /proc
mount -t sysfs sys /sys
grep -q ' /dev devtmpfs ' /proc/mounts || mount -t devtmpfs dev /dev
exec > /dev/console 2>&1

seconds=$(sed -n 's/.*k7\.seconds=\([0-9]*\).*/\1/p' /proc/cmdline)
seconds=${seconds:-30}
cpus=$(nproc)
ip link set lo up
echo "K7 START cpus=$cpus seconds=$seconds uname=$(uname -r)"

# hackbench (realtime-tests): groups of processes passing messages through pipes; fixed
# work (500 loops per second of test: the same amount for the same k7.seconds), the
# metric is the time. Lower is better.
loops=$(( seconds * 500 ))
t=$(hackbench -p -g "$cpus" -l "$loops" 2>&1 | sed -n 's/^Time: //p')
echo "K7 hackbench_s ${t:-nan} s"

# schbench: wakeup latency (p99) and requests per second (p50) with two message threads
# and one worker per CPU. Latency: lower is better; RPS: higher is better.
out=$(schbench -m 2 -t "$cpus" -r "$seconds" 2>&1)
wake=$(echo "$out" | awk '/^Wakeup Latencies/{s=1} /^Request Latencies|^RPS/{s=0} s && /99\.0th:/ { sub(/.*99\.0th: */, ""); sub(/ .*/, ""); print; exit }')
rps=$(echo "$out" | awk '/^RPS percentiles/{s=1} s && /50\.0th:/ { sub(/.*50\.0th: */, ""); sub(/ .*/, ""); print; exit }')
echo "K7 schbench_wakeup_p99_us ${wake:-nan} us"
echo "K7 schbench_rps_p50 ${rps:-nan} rps"

# fio with the null ioengine: fio's I/O path without a disk, one job per CPU; read IOPS
# from the minimal format (field 8). Higher is better.
iops=$(fio --name=null --ioengine=null --rw=randread --bs=4k --size=1G --time_based --runtime="$seconds" \
  --numjobs="$cpus" --group_reporting --minimal | awk -F';' 'NR == 1 { print $8 }')
echo "K7 fio_null_read_iops ${iops:-nan} iops"

# netperf on loopback: TCP_STREAM throughput (Mbit/s) and TCP_RR transactions per second.
# Higher is better. netperf resolves hosts with AI_ADDRCONFIG and glibc does not count
# 127.0.0.1 and ::1 among the configured addresses: with loopback alone not even
# "127.0.0.1" resolves. One extra address on lo is enough. netserver in the foreground:
# its errors reach the serial console, and it is waited for instead of a timed sleep.
ip addr add 10.99.0.1/32 dev lo
netserver -D -p 12865 &
i=0; until netstat -tln | grep -q ':12865 '; do i=$((i + 1)); [ "$i" -ge 10 ] && break; sleep 1; done
tp=$(netperf -H 127.0.0.1 -p 12865 -t TCP_STREAM -l "$seconds" -P 0 -- -o throughput | tail -n 1)
rr=$(netperf -H 127.0.0.1 -p 12865 -t TCP_RR -l "$seconds" -P 0 -- -o transaction_rate | tail -n 1)
echo "K7 netperf_tcp_stream_mbps ${tp:-nan} Mbit/s"
echo "K7 netperf_tcp_rr_tps ${rr:-nan} tps"

echo "K7 RESULT ok"
sync
reboot -f
