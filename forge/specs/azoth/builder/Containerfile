# Athanor OS: kernel build environment (docs/architecture/doc_kernel_build.md, section 5).
#
# The kernel is the Fedora package (kernel.spec from the SRPM pinned in ../pins.env)
# rebuilt with clang on top of the CachyOS base: it needs dnf, the Fedora RPM macros and
# the LLVM toolchain, which the Nix builder of the forge lacks. build.sh installs the
# BuildRequires of the pinned spec with `dnf builddep`: only the base is here.
# The image is pinned by digest: it is the only input the repository does not version.
FROM registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b

# No weak dependencies and no cache: the image stays minimal.
RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

# LLVM toolchain (clang, lld), RPM tools and the dnf5 builddep plugin, rust and bindgen
# for CONFIG_RUST, dwarves (pahole) for the BTF, gnupg2 for the source signatures,
# python3 for Fedora's merge.py, python3-koji to restitch the SRPM signature.
RUN dnf -y install \
      rpm-build dnf5-plugins python3-koji \
      clang lld llvm \
      gcc gcc-c++ make flex bison bc patch diffutils findutils \
      ncurses-devel elfutils-libelf-devel elfutils-devel openssl-devel openssl dwarves \
      rust cargo rustfmt bindgen-cli \
      tar cpio xz curl git gnupg2 python3 \
    && dnf clean all
