# Athanor OS: kernel build environment (docs/architecture/doc_kernel_build.md, section 5).
#
# The kernel is the Fedora package (kernel.spec from the SRPM pinned in ../pins.env)
# rebuilt with clang on top of the CachyOS base: it needs dnf, the Fedora RPM macros and
# the LLVM toolchain, which the Nix builder of the forge lacks.
# The image is pinned by digest, and everything installed on top of it by sha256 in
# toolchain.lock: the tools of the build and the BuildRequires of the pinned spec, which
# build.sh then only checks with `dnf builddep` with every repository disabled. The same
# RPMs at every build, so the same pins give the same kernel. lock.sh generate rewrites
# the lock when this base or the pinned SRPM change. Build context: forge/specs/azoth.
FROM registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b

# No weak dependencies and no cache: the image stays minimal.
RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

COPY lock.sh /usr/local/share/azoth/
COPY builder/toolchain.lock /usr/local/share/azoth/toolchain.lock
RUN bash /usr/local/share/azoth/lock.sh install /usr/local/share/azoth/toolchain.lock
