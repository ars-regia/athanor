[Unit]
Description=Athanor shell daemon: desktop notifications and the StatusNotifier watcher
# Started with the session by its preset, and by the bus when a client calls one of its
# names first (doc_bar.md, BR1 and BR8).
After=graphical-session.target
PartOf=graphical-session.target
# The daemon counts its own failures and gives up after five in ten minutes
# (doc_shell.md, SH8); this is only the outer backstop.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=notify
ExecStart=/usr/bin/athanor-shelld
ExecStopPost=/usr/bin/athanor-shelld --record-exit
TimeoutStartSec=10s
Restart=on-failure
# Every restart comes at once, so a crash costs under a second (doc_shell_standard.md, ST5,
# recovery). No RestartSteps: systemd keeps counting restarts for the whole session, so the
# third crash of a day would wait seconds. After five failures in ten minutes the program
# falls back or gives up (SH8), which ends a crash loop the user's configuration causes; a
# loop with any other cause reaches StartLimitBurst above within seconds rather than minutes
# and leaves the unit failed until the next login.
RestartSec=100ms
Slice=session.slice
# Budget 16 MB PSS at rest (doc_bar.md, section 5, item 17); MemoryHigh throttles early, well
# above that budget, to leave room for a large image-data message in flight. MemoryMax is the
# hard cap: the bus accepts messages up to 128 MiB and zbus buffers a whole message before any
# parser sees it, so the cap must clear 128 MiB plus the baseline, or one maximum-size message
# OOM-kills the daemon — and five of them switch it off for the session (crash-loop, SH8).
MemoryHigh=48M
MemoryMax=192M

# The failure record lives here and must survive a stop, not just a restart: a clean give-up
# exit to inactive (SH8) must still be a give-up the next time this unit starts, including
# when the bar's unit (2b.2) starts it after a full stop. Only the session ending clears it.
RuntimeDirectory=athanor-shelld
RuntimeDirectoryPreserve=yes
# The do-not-disturb state and the history in ~/.local/state/athanor/shelld, the rules and the
# settings in ~/.config/athanor/notifications (doc_notification_center.md, NC3, NC4). The
# manager creates both before it builds the sandbox: with ProtectHome=read-only the daemon
# could not create them on a first start, and a path that does not exist is dropped from
# ReadWritePaths. ConfigurationDirectory only creates; it does not make the directory
# writable, so ReadWritePaths does (%E is $XDG_CONFIG_HOME as the manager sees it, the root
# ConfigurationDirectory uses); StateDirectory is writable by itself. The daemon takes both
# paths from $STATE_DIRECTORY and $CONFIGURATION_DIRECTORY, so they cannot disagree.
StateDirectory=athanor/shelld
ConfigurationDirectory=athanor/notifications
ReadWritePaths=%E/athanor/notifications

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The daemon speaks only D-Bus and journald, both over Unix sockets.
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=athanor-session.target
