<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  Polkit actions of athanor-cloud-rs.

  Fixed 2026-09-02: this file declared "os.athanor.cloud.trust", which no code
  checks, while the only action the daemon enforces, "os.athanor.cloudsync.mount"
  (src/main.rs), was declared nowhere. The wrong id made every mount denied.
-->
<policyconfig>
  <vendor>Athanor OS</vendor>
  <vendor_url>https://github.com/ars-regia/athanor</vendor_url>

  <!-- Mounts an arbitrary FUSE remote on an arbitrary mountpoint, both chosen by
       the caller. The call site passes allow_user_interaction = true, so
       auth_admin_keep can actually show the dialog. -->
  <action id="os.athanor.cloudsync.mount">
    <description>Mount a remote cloud filesystem</description>
    <description xml:lang="it">Montare un filesystem cloud remoto</description>
    <message>Authentication is required to mount a remote filesystem on this computer.</message>
    <message xml:lang="it">È richiesta l'autenticazione per montare un filesystem remoto su questo computer.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
