# ==============================================================================
# 🌋 Athanor Forge - Task Runner (Justfile)
# Centralized command runner for build pipelines, kernel engineering, and CI/CD
# ==============================================================================

[private]
default:
    @just --list

# Compiles an upstream RPM package locally in a rolling build environment with dnf and custom rpmmacros
[group('Package Build')]
build-rolling package:
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/build_rolling_local.sh "{{ package }}"

# Runs deterministic hermetic build using Bubblewrap sandbox without network (Nix Paradigm)
[group('Package Build')]
hermetic-build lockfile="athanor-build.lock":
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/nix_hermetic_build.sh "{{ lockfile }}"

# Checks if a package OCI container image already exists on GHCR using deterministic SHA-256 hashing
[group('CI/CD Pipeline')]
check-idempotency package registry="ghcr.io" owner="hr-mes" image_name="" base_digest="":
    #!/usr/bin/env bash
    set -euo pipefail
    ARGS=("--package" "{{ package }}" "--registry" "{{ registry }}" "--owner" "{{ owner }}")
    if [ -n "{{ image_name }}" ]; then ARGS+=("--image-name" "{{ image_name }}"); fi
    if [ -n "{{ base_digest }}" ]; then ARGS+=("--base-digest" "{{ base_digest }}"); fi
    bash scripts/check_idempotency.sh "${ARGS[@]}"

# Evaluates package arrays from config/packages.json and outputs dynamic GitHub Actions build matrix JSON
[group('CI/CD Pipeline')]
dynamic-matrix:
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/dynamic-matrix.sh

# Downloads and extracts micro-container RPM images (Tier 0-3) from GHCR, deduplicating versions
[group('CI/CD Pipeline')]
fetch-repo-rpms owner="hr-mes":
    #!/usr/bin/env bash
    set -euo pipefail
    bash ../system/kernel-artifacts.sh require-ready
    bash scripts/fetch_repo_rpms.sh "{{ owner }}"

# Cleans up old and untagged container package versions on GHCR
[group('CI/CD Pipeline')]
clean-ghcr owner="hr-mes":
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/clean_ghcr.sh "{{ owner }}"

# Moves the watched specs to their latest upstream releases (what the nightly workflow runs)
[group('CI/CD Pipeline')]
update-specs:
    python3 scripts/zero_trust_updater.py out/spec-updates.md

# Fetches upstream kernel SRPM, applies CachyOS BORE patches, computes NVIDIA shield ceiling, and merges Kconfig tuning
[group('Kernel Build')]
kernel-prepare mode="full":
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{ mode }}" = "meta" ]; then
        bash specs/azoth/prepare-chimera.sh --meta
    else
        bash specs/azoth/prepare-chimera.sh
    fi

# Runs containerized local build of Chimera kernel with Clang/ThinLTO inside a privileged Fedora 43 OCI container
[group('Kernel Build')]
kernel-build-local:
    #!/usr/bin/env bash
    set -euo pipefail
    bash specs/azoth/build-local.sh

# Builds kpatch kernel livepatch module and packages it into an RPM
[group('Kernel Build')]
livepatch-build:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f specs/athanor-livepatch/athanor-livepatch.spec ]; then
        rpmbuild -ba specs/athanor-livepatch/athanor-livepatch.spec
    else
        echo "Error: specs/athanor-livepatch/athanor-livepatch.spec not found" >&2
        exit 1
    fi

# Inject livepatch kernel modules without reboot
[group('Kernel Build')]
livepatch-inject:
    #!/usr/bin/env bash
    set -euo pipefail
    bash specs/athanor-livepatch/athanor-livepatch-injector.sh

# Runs Rust Clippy policies, Cargo Vet cryptographic supply-chain audit, and Cargo Deny security check
[group('QA & Validation')]
audit:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clippy --all-targets --all-features -- -D clippy::undocumented_unsafe_blocks -D clippy::multiple_unsafe_ops_per_block -D warnings
    cargo vet check
    cargo deny check

# Runs cargo-fuzz fuzzing harness across Rust components
[group('QA & Validation')]
fuzz component="all" time="60":
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/run_fuzz.sh "{{ component }}" "{{ time }}"

# Runs AWS Kani formal verification proof harnesses on Rust spec targets
[group('QA & Validation')]
verify component="athanor-gatekeeper-rs":
    #!/usr/bin/env bash
    set -euo pipefail
    LD_LIBRARY_PATH=/usr/lib64:/lib64:${LD_LIBRARY_PATH:-} PATH=/home/athanor/.cargo/bin:$PATH cargo kani --package "{{ component }}"

# Validates NVIDIA kernel module loading (nvidia, uvm, drm, modeset) and GPU device nodes
[group('QA & Validation')]
test-nvidia-modules:
    #!/usr/bin/env bash
    set -euo pipefail
    bash specs/athanor-qa/SOURCES/test-nvidia-modules.sh

# Runs shellcheck on all Bash scripts in forge/
[group('Utility')]
lint:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v shellcheck >/dev/null 2>&1; then find . -iname "*.sh" -type f -exec shellcheck "{}" +; else echo "shellcheck not found, skipping"; fi

# Runs shfmt on all Bash scripts in forge/
[group('Utility')]
format:
    #!/usr/bin/env bash
    set -euo pipefail
    find . -iname "*.sh" -type f -exec shfmt --write "{}" +

# Validates Justfile syntax
[group('Utility')]
check-syntax:
    just --unstable --fmt --check -f Justfile
